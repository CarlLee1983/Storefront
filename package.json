{
  "name": "storefront",
  "private": true,
  "workspaces": [
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:coverage": "bun run --filter '*' test:coverage",
    "e2e": "bun run --filter @storefront/e2e e2e",
    "dev": "bun run --filter @storefront/web dev",
    "db:migrate": "bun run --filter @storefront/app db:migrate:local && bun run --filter @storefront/gateway db:migrate:local",
    "dev:gateway": "bun run --filter @storefront/gateway dev",
    "admin:dev-token": "bun run --filter @storefront/app admin:dev-token",
    "seed": "bun e2e/seed/demo-seed.ts",
    "preview": "bun run --filter @storefront/web preview",
    "db:migrate:gateway:preview": "bun run --filter @storefront/gateway db:migrate:preview",
    "deploy:gateway:preview": "bun run --filter @storefront/gateway deploy:preview",
    "db:migrate:preview": "bun run --filter @storefront/app db:migrate:preview",
    "deploy:app:preview": "bun run --filter @storefront/app deploy:preview",
    "deploy:web:preview": "bun run --filter @storefront/web deploy:preview",
    "db:migrate:gateway:production": "bun run --filter @storefront/gateway db:migrate:production",
    "deploy:gateway:production": "bun run --filter @storefront/gateway deploy:production",
    "db:migrate:production": "bun run --filter @storefront/app db:migrate:production",
    "deploy:app:production": "bun run --filter @storefront/app deploy:production",
    "deploy:web:production": "bun run --filter @storefront/web deploy:production"
  }
}
