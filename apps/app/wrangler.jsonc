{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storefront-app",
  "main": "src/entrypoint.ts",
  "compatibility_date": "2026-08-01",
  // Better Auth 需要 AsyncLocalStorage 與 node:crypto（Holdfast ADR 0008）
  "compatibility_flags": ["nodejs_compat"],
  // 只給 Web Worker 經 Service Binding 呼叫，不對外公開（無 workers.dev、無 routes）
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // 每分鐘一次的 Cron：把超過付款期限的待付款訂單轉為已逾期、釋放保留（冪等）。
  // triggers 不會被 env 繼承，各環境自己宣告。
  "triggers": { "crons": ["* * * * *"] },
  // Cloudflare Access 驗簽設定，純文字變數、不是 secret。vars 不會被 env 繼承，各環境自己宣告。
  // 空字串 = 尚未設定，管理 RPC 一律 fail closed（unauthorized）。
  // 頂層只給本機開發與測試：本機值由 `bun run admin:dev-token` 寫進 .dev.vars，測試由 vitest.config.ts 注入。
  // ACCESS_JWKS_JSON（內嵌 JWKS）只允許出現在本機 .dev.vars，preview / production 不得定義。
  //
  // BETTER_AUTH_URL 是瀏覽器看到的 Web Worker 公開 origin（OAuth redirect_uri 由它組成），同樣純文字、各環境自己宣告。
  // 顧客登入的 secrets（BETTER_AUTH_SECRET、GOOGLE_*、LINE_*）不寫在這裡，見 README「顧客登入」。
  //
  // GATEWAY_BASE_URL 是金流閘道 Worker 的網址（純文字、各環境自己宣告；本機預設是 `bun run dev:gateway` 的位址）。
  // 付款的 secret GATEWAY_API_KEY 不寫在這裡，見 README「付款」。缺少任一個時只有付款相關 RPC（startPayment、confirmPayment）
  // 回 payment_unavailable，其餘 RPC 不受影響。
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "BETTER_AUTH_URL": "http://localhost:4321",
    "GATEWAY_BASE_URL": "http://localhost:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "storefront",
      "migrations_dir": "migrations"
    }
  ],
  // d1_databases 不會被 env 繼承，各環境必須自己宣告；Worker 名稱由 wrangler 加上 -<env> 後綴
  // （storefront-app-preview / storefront-app-production）。頂層（無 env）維持本機開發與測試用。
  // 標示 REPLACE_WITH_ 的值需要真實的 Cloudflare 帳號資源，部署前必須填入。
  "env": {
    "preview": {
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": ["* * * * *"] },
      // BETTER_AUTH_URL 是該環境 Web 的公開 origin，必須等於 apps/web/wrangler.jsonc 該環境的 routes 網域
      // （OAuth callback 由它組成，須在 Google 與 LINE 後台登記 /api/auth/callback/{google,line}）
      "vars": {
        "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
        "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD_TAG",
        "BETTER_AUTH_URL": "https://REPLACE_WITH_PREVIEW_DOMAIN",
        "GATEWAY_BASE_URL": "https://REPLACE_WITH_PREVIEW_GATEWAY_DOMAIN"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "storefront-preview",
          "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": ["* * * * *"] },
      // BETTER_AUTH_URL 同 preview：等於 apps/web/wrangler.jsonc production routes 的網域
      "vars": {
        "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
        "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD_TAG",
        "BETTER_AUTH_URL": "https://REPLACE_WITH_PRODUCTION_DOMAIN",
        "GATEWAY_BASE_URL": "https://REPLACE_WITH_PRODUCTION_GATEWAY_DOMAIN"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "storefront-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
