---
// PROTOTYPE — 浮動切換列：← 版型 →、三頁分頁；方向鍵也能切版型。只在 astro dev 出現。
interface Props { page: string; variant: "A" | "B" | "C"; url: URL }
const { page, variant, url } = Astro.props;
const NAMES = { A: "編輯式格線", B: "目錄索引", C: "沉浸式大圖" } as const;
const KEYS = ["A", "B", "C"] as const;
const i = KEYS.indexOf(variant);
const href = (v: string, p = page) => {
  const next = new URL(url);
  next.pathname = `/prototype/redesign/${p}`;
  next.searchParams.set("variant", v);
  if (p !== page) for (const k of ["sort", "instock", "sale", "page"]) next.searchParams.delete(k);
  return `${next.pathname}${next.search}`;
};
const prev = href(KEYS[(i + 2) % 3]!);
const next = href(KEYS[(i + 1) % 3]!);
const pages = [["product", "詳情"], ["category", "列表"], ["cart", "購物車"]] as const;
---

{import.meta.env.DEV && (
  <nav class="proto-bar" aria-label="Prototype 切換">
    <a href={prev} data-proto="prev" aria-label="上一個版型">←</a>
    <strong>{variant} — {NAMES[variant]}</strong>
    <a href={next} data-proto="next" aria-label="下一個版型">→</a>
    <span class="sep" aria-hidden="true"></span>
    {pages.map(([p, label]) => <a href={href(variant, p)} aria-current={p === page ? "page" : undefined}>{label}</a>)}
  </nav>
)}

<script>
  document.addEventListener("keydown", event => {
    const el = document.activeElement;
    if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement || (el as HTMLElement | null)?.isContentEditable) return;
    if (document.querySelector("dialog[open]")) return;
    const dir = event.key === "ArrowLeft" ? "prev" : event.key === "ArrowRight" ? "next" : null;
    if (!dir) return;
    const link = document.querySelector<HTMLAnchorElement>(`[data-proto="${dir}"]`);
    if (link) location.href = link.href;
  });
</script>

<style>
  .proto-bar {
    position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%); z-index: 9999;
    display: flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 999px;
    background: #2b1f6b; color: #fff; font: 600 13px/1.2 system-ui, sans-serif; white-space: nowrap;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
  }
  .proto-bar a { color: #fff; text-decoration: none; padding: 4px 6px; border-radius: 6px; }
  .proto-bar a[aria-current="page"] { background: #fff; color: #2b1f6b; }
  .proto-bar .sep { width: 1px; height: 16px; background: rgb(255 255 255 / 0.4); }
</style>
