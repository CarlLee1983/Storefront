---
// PROTOTYPE — 版型 B「目錄索引」：瑞士印刷式的編號索引。商品以清單列呈現（不是卡片網格），
// 詳情頁是長條圖片堆疊＋窄欄規格書，購物車是收據。資訊密度高、圖片退居輔助。
import Art from "./Art.astro";
import { CART, CATEGORIES, DETAIL, DETAIL_COPY, DETAIL_GALLERY, DETAIL_SPECS, RELATED, SORTS, cartTotal, discountPct, listing, readListing, twd, withParams } from "./fixtures";

interface Props { page: "product" | "category" | "cart"; url: URL }
const { page, url } = Astro.props;
const q = readListing(url);
const living = CATEGORIES[0]!;
const list = listing(living.slug, q);
const cartCount = CART.reduce((n, l) => n + l.quantity, 0);
const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="b">
  <header class="top">
    <a class="brand" href="#">Storefront<span>®</span></a>
    <nav class="index-nav" aria-label="主要導覽">
      <ol>
        <li><a href="#"><span class="n">00</span>全部商品</a></li>
        {CATEGORIES.map((c, i) => <li><a href="#" aria-current={page === "category" && c.slug === living.slug ? "page" : undefined}><span class="n">{pad(i + 1)}</span>{c.name}</a></li>)}
        <li><a href="#" class="sale"><span class="n">%</span>特價</a></li>
      </ol>
    </nav>
    <div class="tools">
      <form role="search" class="inline-search"><label class="sr-only" for="b-q">搜尋商品</label><input id="b-q" type="search" placeholder="搜尋" /></form>
      <a href="#" class="desk-only">登入</a>
      <a href="#">購物車 <span class="pill">{cartCount}</span></a>
      <button type="button" class="menu-btn" data-open="b-menu" aria-label="開啟選單">索引</button>
    </div>
  </header>

  <dialog id="b-menu" class="drawer menu" aria-label="選單">
    <div class="menu-head"><span class="brand">Storefront</span><button type="button" data-close class="menu-btn">關閉</button></div>
    <form role="search" class="menu-search"><label class="sr-only" for="b-q2">搜尋商品</label><input id="b-q2" type="search" placeholder="搜尋商品" /></form>
    <ol class="menu-index">
      <li><a href="#"><span class="n">00</span>全部商品</a></li>
      {CATEGORIES.map((c, i) => <li><a href="#"><span class="n">{pad(i + 1)}</span>{c.name}</a></li>)}
      <li><a href="#" class="sale"><span class="n">%</span>特價</a></li>
    </ol>
    <p class="menu-foot"><a href="#">登入</a> · <a href="#">我的訂單</a></p>
  </dialog>

  <main>
    {page === "category" && (
      <div class="cat">
        <aside class="side">
          <p class="n big">01</p>
          <h1>{living.name}</h1>
          <p class="side-blurb">{living.blurb}</p>
          <p class="side-count"><b>{list.total}</b> 件</p>
          <div class="side-group" role="group" aria-label="排序">
            <p class="label">排序</p>
            {SORTS.map(s => <a href={withParams(url, { sort: s.key, page: null })} aria-current={q.sort === s.key ? "true" : undefined}>{s.label}</a>)}
          </div>
          <div class="side-group">
            <p class="label">篩選</p>
            <a href={withParams(url, { instock: q.inStock ? null : "1", page: null })} role="switch" aria-checked={q.inStock ? "true" : "false"}>只看有貨</a>
            <a href={withParams(url, { sale: q.onSale ? null : "1", page: null })} role="switch" aria-checked={q.onSale ? "true" : "false"}>只看特價</a>
          </div>
        </aside>
        <div class="rows-wrap">
          <ol class="rows">
            {list.shown.map((p, i) => (
              <li class:list={["row", { "on-sale": p.compareAtTwd, "sold-out": p.available === 0 }]}>
                <span class="n">{pad(i + 1)}</span>
                <a href="#" class="row-img"><Art kind={p.art} tone={p.tone} label={p.name} /></a>
                <a href="#" class="row-name">{p.name}</a>
                <span class="row-meta">{p.available === 0 ? "已售完" : p.compareAtTwd ? `特價 −${discountPct(p)}%` : p.newDays <= 7 ? "新上架" : ""}</span>
                <span class="row-price"><span class="price-now">{twd(p.priceTwd)}</span>{p.compareAtTwd && <s class="price-was"><span class="sr-only">原價</span>{twd(p.compareAtTwd)}</s>}</span>
                <button type="button" class="row-add" disabled={p.available === 0}>加入<span class="sr-only">{p.name}到購物車</span></button>
              </li>
            ))}
          </ol>
          <p class="more">
            <span>{list.shown.length} / {list.total}</span>
            {list.hasMore && <a href={withParams(url, { page: String(q.page + 1) })}>＋ 載入更多</a>}
          </p>
        </div>
      </div>
    )}

    {page === "product" && (
      <div class="pdp">
        <div class="stack">
          {DETAIL_GALLERY.map((g, i) => <figure><Art kind={g.art} tone={g.tone} bg={g.bg} label={`${DETAIL.name}，第 ${i + 1} 張`} ratio="portrait" /><figcaption>{pad(i + 1)} / {pad(DETAIL_GALLERY.length)}</figcaption></figure>)}
        </div>
        <article class="sheet on-sale">
          <p class="crumb"><a href="#">04 工作區</a></p>
          <h1>{DETAIL.name}</h1>
          <p class="sheet-price"><span class="price-now">{twd(DETAIL.priceTwd)}</span> <s class="price-was"><span class="sr-only">原價</span>{twd(DETAIL.compareAtTwd!)}</s></p>
          <p class="sheet-flag">特價 −{discountPct(DETAIL)}% · 現貨 {DETAIL.available} 件</p>
          <form class="sheet-buy">
            <label>數量 <select><option>1</option><option>2</option><option>3</option></select></label>
            <button type="button" class="buy-btn">加入購物車</button>
          </form>
          <section><h2><span class="n">01</span>說明</h2><p>{DETAIL_COPY}</p></section>
          <section><h2><span class="n">02</span>規格</h2><dl>{DETAIL_SPECS.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl></section>
          <section><h2><span class="n">03</span>配送與退換</h2><p>含稅、免運。付款後無法自行取消，商品問題請聯繫客服由人工處理。</p></section>
          <section>
            <h2><span class="n">04</span>相關商品</h2>
            <ol class="mini">{RELATED.map(p => <li class:list={{ "on-sale": p.compareAtTwd }}><a href="#">{p.name}</a><span class="price-now">{twd(p.priceTwd)}</span></li>)}</ol>
          </section>
        </article>
      </div>
    )}

    {page === "cart" && (
      <div class="receipt-wrap">
        <section class="receipt" aria-labelledby="b-cart-title">
          <p class="r-head">Storefront<br /><span>購物車明細</span></p>
          <h1 id="b-cart-title" class="sr-only">購物車</h1>
          <ol class="r-lines">
            {CART.map((l, i) => (
              <li>
                <div class="r-thumb"><Art kind={l.product.art} tone={l.product.tone} label="" /></div>
                <div class="r-body">
                  <p class="r-name"><span class="n">{pad(i + 1)}</span>{l.product.name}</p>
                  <p class="r-calc"><span>{twd(l.product.priceTwd)} × </span><input aria-label={`${l.product.name}的數量`} inputmode="numeric" value={l.quantity} /><span class="dots" aria-hidden="true"></span><b>{twd(l.product.priceTwd * l.quantity)}</b></p>
                  <button type="button" class="r-remove">移除<span class="sr-only">{l.product.name}</span></button>
                </div>
              </li>
            ))}
          </ol>
          <p class="r-row"><span>運費</span><span class="dots" aria-hidden="true"></span><span>免運</span></p>
          <p class="r-total"><span>合計</span><span class="price-now">{twd(cartTotal())}</span></p>
          <a href="#" class="buy-btn block">前往結帳</a>
          <p class="r-note">單價為加入購物車當時所見的價格；結帳時若價格已變動，會先請你確認。</p>
        </section>
      </div>
    )}
  </main>

  <footer class="foot">
    <p class="brand">Storefront®</p>
    <ol><li><a href="#">關於</a></li><li><a href="#">常見問題</a></li><li><a href="#">退換貨說明</a></li></ol>
  </footer>
</div>

<style>
  .b { font-size: 15px; }
  .n { font-family: var(--latin); font-weight: 700; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; margin-right: 10px; }
  .brand { font-family: var(--latin); font-weight: 800; font-size: 22px; letter-spacing: -0.03em; text-decoration: none; }
  .brand span { font-size: 12px; vertical-align: super; }

  .top { display: grid; grid-template-columns: 1fr auto; gap: 12px; padding: 14px 16px; border-bottom: 2px solid var(--ink); align-items: center; position: sticky; top: 0; background: var(--paper); z-index: 10; }
  .index-nav { display: none; }
  .index-nav ol { list-style: none; margin: 0; padding: 0; display: flex; gap: 22px; }
  .index-nav a { text-decoration: none; }
  .index-nav a[aria-current="page"] { border-bottom: 2px solid var(--ink); }
  .sale, .sale .n { color: var(--accent); font-weight: 700; }
  .tools { display: flex; gap: 14px; align-items: center; }
  .tools a { text-decoration: none; }
  .pill { display: inline-grid; place-items: center; min-width: 22px; height: 22px; border-radius: 11px; background: var(--ink); color: #fff; font: 700 12px var(--latin); }
  .inline-search, .desk-only { display: none; }
  .inline-search input { border: 0; border-bottom: 1px solid var(--ink); padding: 6px 2px; width: 160px; font: inherit; }
  .menu-btn { border: 1px solid var(--ink); background: none; padding: 8px 12px; cursor: pointer; font-weight: 700; }
  @media (min-width: 1000px) {
    .top { grid-template-columns: auto 1fr auto; gap: 40px; padding: 16px 32px; }
    .index-nav, .inline-search, .desk-only { display: block; }
    .menu-btn { display: none; }
  }

  .menu { background: var(--paper); padding: 0 16px; }
  .menu-head { display: flex; justify-content: space-between; align-items: center; padding: 14px 0; border-bottom: 2px solid var(--ink); }
  .menu-search input { width: 100%; margin: 16px 0; padding: 12px 0; border: 0; border-bottom: 1px solid var(--ink); font-size: 18px; }
  .menu-index { list-style: none; margin: 0; padding: 0; }
  .menu-index a { display: flex; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 34px; font-weight: 800; letter-spacing: -0.02em; text-decoration: none; }
  .menu-foot { padding: 20px 0; }

  .cat { display: grid; }
  .side { padding: 24px 16px; border-bottom: 1px solid var(--line); }
  .n.big { font-size: 14px; margin: 0; }
  .side h1 { font-size: clamp(48px, 12vw, 88px); margin: 0; line-height: 1; letter-spacing: -0.03em; font-weight: 800; }
  .side-blurb { margin: 8px 0 4px; color: var(--muted); }
  .side-count { margin: 0 0 20px; font-family: var(--latin); }
  .side-group { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: center; margin-bottom: 12px; }
  .side-group .label { width: 100%; margin: 0; font-size: 12px; color: var(--muted); }
  .side-group a { text-decoration: none; padding: 6px 0; min-height: 36px; }
  .side-group a[aria-current="true"], .side-group a[aria-checked="true"] { font-weight: 800; text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 2px; }
  .side-group a[role="switch"]::before { content: "□ "; }
  .side-group a[aria-checked="true"]::before { content: "■ "; color: var(--accent); }
  @media (min-width: 1000px) {
    .cat { grid-template-columns: 280px 1fr; }
    .side { position: sticky; top: 70px; align-self: start; padding: 32px; border: 0; border-right: 1px solid var(--line); min-height: calc(100vh - 70px); }
    .side-group { display: grid; gap: 2px; }
  }

  .rows { list-style: none; margin: 0; padding: 0; }
  .row { display: grid; grid-template-columns: auto 72px 1fr auto; grid-template-areas: "n img name add" "n img price add" "n img meta add"; gap: 0 12px; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .row > .n { grid-area: n; align-self: start; padding-top: 4px; }
  .row-img { grid-area: img; width: 72px; aspect-ratio: 1; display: block; }
  .row-name { grid-area: name; font-weight: 700; text-decoration: none; }
  .row-meta { grid-area: meta; font-size: 12px; color: var(--muted); }
  .on-sale .row-meta { color: var(--accent); font-weight: 700; }
  .row-price { grid-area: price; display: flex; gap: 8px; align-items: baseline; }
  .row-price .price-was { font-size: 12px; }
  .row-add { grid-area: add; border: 1px solid var(--ink); background: none; padding: 10px 14px; cursor: pointer; font-weight: 700; }
  .row-add:disabled { border-color: var(--line); color: var(--muted); cursor: not-allowed; }
  .sold-out .row-img { opacity: 0.5; }
  @media (min-width: 1000px) {
    .row { grid-template-columns: 40px 96px 1fr 140px 180px 90px; grid-template-areas: "n img name meta price add"; padding: 14px 32px; }
    .row-img { width: 96px; }
    .row-name { font-size: 18px; }
    .row-price { justify-content: flex-end; }
    .row:hover { background: var(--panel); }
  }
  .more { display: flex; justify-content: space-between; padding: 20px 16px 48px; font-family: var(--latin); }
  .more a { font-weight: 800; color: var(--accent); }
  @media (min-width: 1000px) { .more { padding: 24px 32px 64px; } }

  .pdp { display: grid; }
  .stack { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; }
  .stack figure { margin: 0; flex: 0 0 88%; scroll-snap-align: start; position: relative; aspect-ratio: 4 / 5; border-right: 1px solid var(--paper); }
  .stack figcaption { position: absolute; left: 12px; bottom: 10px; font: 700 12px var(--latin); }
  .sheet { padding: 24px 16px 48px; }
  .crumb { margin: 0 0 8px; font-size: 13px; }
  .sheet h1 { font-size: clamp(30px, 6vw, 44px); margin: 0 0 12px; letter-spacing: -0.02em; line-height: 1.1; font-weight: 800; }
  .sheet-price { font-size: 26px; margin: 0; }
  .sheet-price .price-was { font-size: 16px; }
  .sheet-flag { color: var(--accent); font-weight: 700; font-size: 13px; margin: 6px 0 20px; }
  .sheet-buy { display: grid; grid-template-columns: auto 1fr; gap: 10px; align-items: center; padding-bottom: 24px; border-bottom: 2px solid var(--ink); }
  .sheet-buy select { margin-left: 6px; padding: 12px; border: 1px solid var(--ink); font: inherit; background: none; }
  .buy-btn { display: block; text-align: center; text-decoration: none; padding: 16px; background: var(--ink); color: #fff; border: 0; font-weight: 800; font-size: 16px; cursor: pointer; }
  .buy-btn:hover { background: var(--accent); }
  .sheet section { border-bottom: 1px solid var(--line); padding: 18px 0; }
  .sheet h2 { font-size: 15px; margin: 0 0 10px; }
  .sheet section p { margin: 0; line-height: 1.8; }
  .sheet dl { display: grid; grid-template-columns: 6em 1fr; gap: 6px; margin: 0; }
  .sheet dt { color: var(--muted); }
  .sheet dd { margin: 0; }
  .mini { list-style: none; margin: 0; padding: 0; }
  .mini li { display: flex; justify-content: space-between; padding: 8px 0; }
  @media (min-width: 1000px) {
    .pdp { grid-template-columns: 1fr 420px; }
    .stack { display: grid; overflow: visible; gap: 2px; }
    .stack figure { aspect-ratio: 4 / 3; border: 0; }
    .sheet { position: sticky; top: 70px; align-self: start; padding: 32px; max-height: calc(100vh - 70px); overflow: auto; }
  }

  .receipt-wrap { background: var(--panel); padding: 24px 12px 48px; }
  .receipt { max-width: 520px; margin: 0 auto; background: var(--paper); padding: 28px 20px; box-shadow: 0 1px 0 var(--line); font-variant-numeric: tabular-nums; }
  .r-head { text-align: center; font: 800 24px/1.2 var(--latin); margin: 0 0 20px; border-bottom: 2px dashed var(--ink); padding-bottom: 16px; }
  .r-head span { font: 400 14px var(--body); color: var(--muted); }
  .r-lines { list-style: none; margin: 0; padding: 0; }
  .r-lines li { display: grid; grid-template-columns: 56px 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px dotted var(--muted); }
  .r-thumb { width: 56px; aspect-ratio: 1; }
  .r-name { margin: 0 0 6px; font-weight: 700; }
  .r-calc, .r-row { display: flex; align-items: baseline; gap: 6px; margin: 0; font-family: var(--latin); }
  .r-calc input { width: 40px; border: 1px solid var(--line); text-align: center; font: inherit; padding: 4px; }
  .dots { flex: 1; border-bottom: 1px dotted var(--muted); transform: translateY(-4px); }
  .r-remove { border: 0; background: none; padding: 6px 0; text-decoration: underline; font-size: 13px; cursor: pointer; color: var(--muted); }
  .r-row { padding: 12px 0; }
  .r-total { display: flex; justify-content: space-between; align-items: baseline; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); padding: 14px 0; margin: 4px 0 20px; font-weight: 800; }
  .r-total .price-now { font-size: 30px; }
  .r-note { font-size: 13px; color: var(--muted); margin: 14px 0 0; }

  .foot { border-top: 2px solid var(--ink); padding: 24px 16px 32px; display: flex; flex-wrap: wrap; gap: 16px 40px; align-items: baseline; }
  .foot ol { list-style: none; margin: 0; padding: 0; display: flex; gap: 20px; }
  @media (min-width: 1000px) { .foot { padding: 32px; } }
</style>
