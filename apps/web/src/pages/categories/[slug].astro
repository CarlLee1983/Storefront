---
import { env } from "cloudflare:workers";
import ProductListing from "../../components/ProductListing.astro";
import NotFoundContent from "../../components/NotFoundContent.astro";
import Layout from "../../layouts/Layout.astro";
import { notFoundDescription, previewText } from "../../metadata";

export const prerender = false;

// 代稱不合法、分類不存在、分類沒有上架商品，App 一律回 not_found
const result = await env.APP.getCategory({ slug: Astro.params.slug });
const category = result.ok ? result.data : null;
if (!category) Astro.response.status = 404;
---

<Layout title={category?.name ?? "找不到這個頁面"} headTitle={category ? undefined : "找不到頁面｜靜物"} description={category ? previewText(category.description, "") ? `在靜物探索${category.name}商品。${previewText(category.description, "")}` : `在靜物探索${category.name}的家具與器物。` : notFoundDescription} image={category?.image?.variants.at(-1)?.key ? `/images/${category.image.variants.at(-1)!.key}` : undefined} noindex={!category}>
  {
    category ? (
      <>
        <p class="category-description">{category.description}</p>
        <p class="category-count">分類共 {category.listedProductCount} 件商品</p>
        <ProductListing category={category.slug} />
      </>
    ) : <NotFoundContent />
  }
</Layout>

<style>
  .category-description { font-size: var(--text-lg); }
  .category-count { color: var(--color-muted); }
</style>
