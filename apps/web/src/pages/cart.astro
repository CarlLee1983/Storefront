---
import { MAX_QUANTITY } from "../cart/cart";
import QuantityStepper from "../components/QuantityStepper.astro";
import Layout from "../layouts/Layout.astro";

export const prerender = false;
---

<Layout title="購物車" noindex hideTitle>
  <h1 class="cart-title">購物車</h1>
  <div id="cart-empty" class="cart-empty-panel" hidden>
    <div class="empty-icon-wrap" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
        <path d="M3 6h18" />
        <path d="M16 10a4 4 0 0 1-8 0" />
      </svg>
    </div>
    <h2>購物車目前是空的</h2>
    <p>挑選一件陪伴日常的器物，為生活空間帶來沈靜而舒適的秩序。</p>
    <a class="button-link" href="/products">挑選商品</a>
  </div>
  <p id="cart-error" class="error" role="alert" hidden></p>
  <div id="cart-content" class="cart-layout" hidden>
    <ul id="cart-lines" class="cart-lines" aria-label="購物車商品"></ul>
    <aside class="cart-summary" aria-labelledby="cart-summary-heading">
      <h2 id="cart-summary-heading">訂單摘要</h2>
      <dl>
        <div><dt>小計</dt><dd>NT$ <span id="cart-subtotal">0</span></dd></div>
        <div><dt>運費</dt><dd>結帳時依配送類型計算</dd></div>
      </dl>
      <p class="cart-total"><span>商品合計</span><strong>NT$ <span id="cart-total">0</span></strong></p>
      <p class="cart-currency">金額為新台幣、含稅，未含運費；運費於結帳時依配送類型計算（配送範圍限台灣本島）。</p>
      <a class="checkout-link" href="/checkout">前往結帳</a>
      <p class="cart-note">單價為加入購物車當時所見的價格；結帳時若價格已變動，會先請你確認。</p>
    </aside>
  </div>
  <template id="stepper-template"><QuantityStepper max={MAX_QUANTITY} decreaseLabel="" increaseLabel="" /></template>
</Layout>

<script>
  import { createCartCover } from "../cart/cover";
  import { cartTotal, clampQuantity, lineSubtotal, removeFromCart, setQuantity, type Cart, type CartLine } from "../cart/cart";
  import { loadCart, storageOf } from "../cart/storage";
  import { SAVE_FAILED_MESSAGE } from "../cart/feedback";
  import { updateCart } from "../cart/store";

  const priceFormat = new Intl.NumberFormat("zh-TW");
  const money = (amount: number) => `NT$ ${priceFormat.format(amount)}`;
  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const content = $("#cart-content");
  const stepperTemplate = $<HTMLTemplateElement>("#stepper-template");

  function make<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
    const created = document.createElement(tag);
    if (className) created.className = className;
    if (text !== undefined) created.textContent = text;
    return created;
  }

  // 小計文字前面放給讀屏使用者的「小計」，畫面上只看到金額
  const subtotalText = (line: CartLine) => [
    make("span", "visually-hidden", "小計 "),
    make("span", "line-subtotal-amount", money(lineSubtotal(line))),
  ];

  // 商品名稱來自 localStorage，一律用 textContent，不當 HTML
  function renderLine(line: CartLine) {
    const item = make("li", "cart-line");
    item.dataset.variantId = String(line.variantId);
    const cover = createCartCover(line.cover, line.name);
    cover.classList.add("line-cover");
    const stepper = stepperTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const input = stepper.querySelector<HTMLInputElement>("input")!;
    input.value = String(line.quantity);
    input.setAttribute("aria-label", `${line.name} 數量`);
    input.addEventListener("change", () => change((c) => setQuantity(c, line.variantId, Number(input.value)), input));
    // 以最新的購物車內容加減；已在下限或上限時數量不變
    const stepBy = (delta: number) => (cart: Cart) => {
      const current = cart.lines.find((l) => l.variantId === line.variantId);
      return current ? setQuantity(cart, line.variantId, clampQuantity(current.quantity + delta)) : cart;
    };
    for (const button of stepper.querySelectorAll<HTMLButtonElement>("[data-step]")) {
      const delta = Number(button.dataset.step);
      button.setAttribute("aria-label", `${delta < 0 ? "減少" : "增加"}${line.name}數量`);
      button.addEventListener("click", () => change(stepBy(delta)));
    }
    const remove = make("button", "line-remove button-secondary", "移除");
    remove.type = "button";
    remove.dataset.action = "remove";
    remove.setAttribute("aria-label", `移除${line.name}`);
    remove.addEventListener("click", () => change((c) => removeFromCart(c, line.variantId)));
    const actions = make("div", "line-actions");
    actions.replaceChildren(stepper, remove);
    const main = make("div", "line-main");
    main.replaceChildren(make("span", "line-name", line.name), ...(line.label ? [make("p", "line-variant", line.label)] : []), make("p", "line-price", `單價 ${money(line.unitPriceTwd)}`), actions);
    const subtotal = make("p", "line-subtotal");
    subtotal.replaceChildren(...subtotalText(line));
    item.replaceChildren(cover, main, subtotal);
    return item;
  }

  function renderTotals(cart: Cart) {
    const total = priceFormat.format(cartTotal(cart));
    $("#cart-subtotal").textContent = total;
    $("#cart-total").textContent = total;
  }

  function render(cart: Cart) {
    $("#cart-empty").hidden = cart.lines.length > 0;
    content.hidden = cart.lines.length === 0;
    renderTotals(cart);
    $("#cart-lines").replaceChildren(...cart.lines.map(renderLine));
  }

  // 無效數量（如清空輸入框）會被 setQuantity 拒絕、購物車不變；照樣重畫，輸入框就還原成實際數量
  function change(fn: (cart: Cart) => Cart, quantityInput?: HTMLInputElement) {
    const focused = document.activeElement as HTMLElement | null;
    const row = focused?.closest<HTMLLIElement>("li[data-variant-id]");
    const previousIndex = row ? Array.from(row.parentElement!.children).indexOf(row) : -1;
    const variantId = row?.dataset.variantId;
    const action = focused?.dataset.action;
    const { cart, saved } = updateCart(storageOf(window), window, fn);
    const error = $("#cart-error");
    error.textContent = saved ? "" : SAVE_FAILED_MESSAGE;
    error.hidden = saved;
    // Keep the edited input in the DOM so Tab/Shift+Tab retain their native focus order.
    if (quantityInput) {
      const editedRow = quantityInput.closest<HTMLLIElement>("li")!;
      const line = cart.lines.find(line => String(line.variantId) === editedRow.dataset.variantId);
      if (line) {
        quantityInput.value = String(line.quantity);
        editedRow.querySelector<HTMLElement>(".line-subtotal")!.replaceChildren(...subtotalText(line));
        renderTotals(cart);
        return;
      }
    }
    render(cart);
    if (variantId && action) {
      const next = document.querySelector<HTMLElement>(`li[data-variant-id="${variantId}"] [data-action="${action}"]`)
        ?? document.querySelectorAll<HTMLElement>(`#cart-lines [data-action="${action}"]`)[Math.min(previousIndex, cart.lines.length - 1)]
        ?? document.querySelector<HTMLElement>("#cart-empty a");
      next?.focus();
    }
  }

  const refresh = () => render(loadCart(storageOf(window)));
  refresh();
  // 其他分頁改動了購物車時，本頁跟著更新
  window.addEventListener("storage", refresh);
</script>

<style>
  .cart-title { margin: 0 0 var(--space-6); font-size: var(--text-display-page); line-height: 1.1; letter-spacing: -0.02em; }
  .cart-layout { display: grid; gap: var(--space-6); }
  .cart-layout[hidden] { display: none; }
  .cart-empty-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-12) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-subtle);
    max-width: 32rem;
    margin: var(--space-8) auto;
  }
  .cart-empty-panel[hidden] { display: none; }
  .empty-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    border-radius: var(--radius-full);
    background: var(--color-panel);
    color: var(--color-subtle);
    margin-bottom: var(--space-4);
  }
  .cart-empty-panel h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .cart-empty-panel p {
    margin: 0 0 var(--space-6);
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 24em;
  }
  .button-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-height);
    padding: var(--space-2) var(--space-8);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-on-inverse);
    background: var(--color-primary);
    border-radius: var(--radius-sm);
    box-shadow: 0 1px 3px rgba(158, 61, 44, 0.2);
    transition: all var(--duration-fast) var(--ease-spring);
  }
  .button-link:hover {
    color: var(--color-on-inverse);
    background: var(--color-primary-hover);
    box-shadow: 0 4px 14px rgba(158, 61, 44, 0.3);
    transform: translateY(-1px);
  }
  .cart-lines { min-width: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-border); }
  .cart-summary {
    min-width: 0;
    padding: var(--space-6);
    align-self: start;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-subtle);
  }
  .cart-summary h2 { margin: 0 0 var(--space-4); font-size: var(--text-base); font-weight: 700; }
  .cart-summary dl { margin: 0 0 var(--space-4); }
  .cart-summary dl div { display: flex; justify-content: space-between; gap: var(--space-3); padding-block: var(--space-1); font-size: var(--text-sm); }
  .cart-summary dd { margin: 0; font-weight: 500; }
  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-weight: 700;
  }
  .cart-total strong { font-size: var(--text-xl); color: var(--color-text); }
  .checkout-link {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: var(--control-height);
    background: var(--color-primary);
    color: var(--color-on-inverse);
    font-weight: 600;
    border-radius: var(--radius-sm);
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(158, 61, 44, 0.2);
    transition: all var(--duration-fast) var(--ease-spring);
  }
  .checkout-link:hover {
    background: var(--color-primary-hover);
    color: var(--color-on-inverse);
    box-shadow: 0 4px 14px rgba(158, 61, 44, 0.3);
    transform: translateY(-1px);
  }
  .cart-currency { margin: 0 0 var(--space-4); font-size: var(--text-sm); color: var(--color-muted); }
  .cart-note { margin: var(--space-4) 0 0; font-size: var(--text-sm); color: var(--color-muted); line-height: 1.5; }
  :global(#cart-lines .cart-line) {
    display: grid;
    grid-template-columns: var(--product-thumb-cart-size) minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    align-items: center;
  }
  :global(#cart-lines .line-cover) {
    display: grid;
    place-items: center;
    grid-row: 1 / span 2;
    width: 100%;
    aspect-ratio: 1;
    background: var(--color-panel);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  :global(#cart-lines .line-cover img) { width: 100%; height: 100%; object-fit: cover; }
  :global(#cart-lines .cover-placeholder) { font-size: var(--text-sm); color: var(--color-subtle); text-align: center; }
  :global(#cart-lines .line-main) { min-width: 0; }
  :global(#cart-lines .line-name) { display: block; font-weight: 600; }
  :global(#cart-lines .line-variant) { margin: var(--space-1) 0 0; font-size: var(--text-sm); color: var(--color-muted); }
  :global(#cart-lines .line-price) { margin: var(--space-1) 0 var(--space-2); font-size: var(--text-sm); color: var(--color-muted); }
  :global(#cart-lines .line-actions) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); }
  :global(#cart-lines .line-subtotal) { grid-column: 2; margin: 0; font-size: var(--text-lg); font-weight: 700; color: var(--color-text); }
  :global(#cart-lines .line-remove) {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-muted);
  }
  :global(#cart-lines .line-remove:hover) { background: var(--color-panel); color: var(--color-error); border-color: var(--color-error); }
  @media (min-width: 56.25rem) {
    .cart-layout { grid-template-columns: minmax(0, 1fr) 22rem; gap: var(--space-8); }
    .cart-summary { position: sticky; top: var(--space-4); }
    :global(#cart-lines .cart-line) { grid-template-columns: 100px minmax(0, 1fr) auto; }
    :global(#cart-lines .line-cover) { grid-row: 1; }
    :global(#cart-lines .line-subtotal) { grid-column: 3; grid-row: 1; }
  }
</style>
