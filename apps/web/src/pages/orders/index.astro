---
import { env } from "cloudflare:workers";
import { loginUrl } from "../../auth/customer";
import { checkoutEntry } from "../../checkout/entry";
import Layout from "../../layouts/Layout.astro";
import OrderStatus from "../../orders/OrderStatus.astro";
import OrderFees from "../../orders/OrderFees.astro";
import OrderLines from "../../orders/OrderLines.astro";
import { customerShipmentSummary, formatDateTime } from "../../orders/labels";

export const prerender = false;

// 我的訂單只給顧客，與結帳同一條入口規則：未登入導去登入，登入後回到這一頁
const entry = checkoutEntry(Astro.locals.customer, Astro.url);
if (entry.kind === "redirect") {
  return Astro.redirect(entry.location, 303);
}

const orders = await env.APP.listMyOrders(Astro.request.headers.get("cookie") ?? "");
if (!orders.ok) return Astro.redirect(loginUrl(Astro.url), 303);
---

<Layout title="我的訂單" noindex>
  {orders.data.length === 0 && <div class="empty"><h2>還沒有訂單</h2><p>挑選喜歡的商品，結帳後就能在這裡查看訂單。</p><a href="/products">全部商品</a></div>}
  <ul class="orders">
    {orders.data.map(order => <li class="order-card">
      <div class="heading"><h2><a href={`/orders/${order.id}`}>訂單 #{order.id}</a></h2><p>訂單狀態：<OrderStatus status={order.status} customer /></p></div>
      <p class="created">成立時間：{formatDateTime(order.createdAt)}</p>
      <OrderLines lines={order.lines} />
      {order.status === "shipped" && <p>{customerShipmentSummary(null, order.trackingNumber)}</p>}
      <OrderFees totalTwd={order.totalTwd} shippingFees={order.shippingFees} lines={order.lines} />
      {order.status === "pending_payment" && <div class="payment">
        <p>付款期限：<time datetime={new Date(order.paymentDeadline).toISOString()}>{formatDateTime(order.paymentDeadline)}</time>（台北時間）</p>
        <form method="post" action={`/orders/${order.id}/pay`}><button type="submit" aria-label={`訂單 #${order.id} 前往付款`}>前往付款</button></form>
      </div>}
      <a class="detail" href={`/orders/${order.id}`} aria-label={`查看訂單 #${order.id} 詳情`}>查看訂單詳情</a>
    </li>)}
  </ul>
</Layout>
<style>
  .orders { list-style: none; padding: 0; display: grid; gap: var(--space-6); }
  .order-card, .empty {
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-subtle);
  }
  .heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-2); }
  .heading h2 { margin: 0; font-size: var(--text-lg); font-weight: 700; }
  .heading h2 a { text-decoration: none; color: var(--color-text); }
  .heading h2 a:hover { color: var(--color-primary); }
  .created { color: var(--color-muted); font-size: var(--text-sm); margin: 0 0 var(--space-4); }
  .payment {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .payment p { margin: 0; font-size: var(--text-sm); color: var(--color-muted); }
  .payment button { width: 100%; font-weight: 600; padding: var(--space-2) var(--space-6); }
  .detail {
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
  }
  .detail:hover { color: var(--color-primary); text-decoration: underline; }
  @media(min-width: 40rem) {
    .order-card { padding: var(--space-6); }
    .payment button { width: auto; min-width: 10rem; }
  }
</style>
