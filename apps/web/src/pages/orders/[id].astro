---
import { env } from "cloudflare:workers";
import { loginUrl } from "../../auth/customer";
import { checkoutEntry } from "../../checkout/entry";
import OrderStatus from "../../orders/OrderStatus.astro";
import OrderLines from "../../orders/OrderLines.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDateTime, orderStatusNote, parseOrderId, paymentStatusLabel, refundReasonLabel, shipmentSummary } from "../../orders/labels";
import { cancelErrorMessage, cancelOrderLocation, paymentErrorMessage } from "../../payments/redirects";

export const prerender = false;

// 訂單只給顧客本人：未登入導去登入；別人的訂單與不存在的訂單一樣顯示找不到
const entry = checkoutEntry(Astro.locals.customer, Astro.url);
if (entry.kind === "redirect") {
  return Astro.redirect(entry.location, 303);
}

const orderId = parseOrderId(Astro.params.id);
const cookie = Astro.request.headers.get("cookie") ?? "";

// 取消訂單（POST）：成功後 303 回到本頁重新顯示；訂單已不是待付款（例如剛好逾期、或進行中的付款其實已成功）也回本頁，
// 讓顧客看到最新狀態；進行中的付款處理不了（閘道連不上等）回本頁並帶上原因，訂單維持待付款。找不到訂單則落到下面顯示 404
if (orderId !== null && Astro.request.method === "POST") {
  const cancelled = await env.APP.cancelOrder(cookie, { orderId });
  if (!cancelled.ok && cancelled.reason === "unauthorized") return Astro.redirect(loginUrl(Astro.url), 303);
  if (cancelled.ok || !["order_not_found", "invalid_input"].includes(cancelled.reason)) {
    return Astro.redirect(cancelOrderLocation(orderId, cancelled), 303);
  }
}

const found =
  orderId === null ? null : await env.APP.getMyOrder(cookie, { orderId });
if (found && !found.ok && found.reason === "unauthorized") return Astro.redirect(loginUrl(Astro.url), 303);
const order = found?.ok ? found.data : undefined;
if (!order) Astro.response.status = 404;
// 剛結帳成功導來這一頁：顯示成立訊息（清購物車與冪等鍵在下面的 client script）
const placed = Astro.url.searchParams.get("placed") === "1";
const statusNote = order ? orderStatusNote(order.status) : null;
// 發起付款被拒（/orders/:id/pay 帶回原因），或付款完導回時閘道暫時查不到結果（/orders/:id/payment-return）
const paymentError = paymentErrorMessage(Astro.url.searchParams.get("payment_error"));
const cancelError = cancelErrorMessage(Astro.url.searchParams.get("cancel_error"));
const paymentUnconfirmed = Astro.url.searchParams.get("payment") === "unconfirmed";
const priceFormat = new Intl.NumberFormat("zh-TW");
---

<Layout title={order ? `訂單 #${order.id}` : "找不到訂單"} noindex>
  {
    !order ? (
      <p class="error" role="alert">找不到這張訂單。<a href="/orders">回我的訂單</a></p>
    ) : (
      <>
        {placed && <p role="status">訂單已成立，商品已為你保留。</p>}
        {paymentError && <p class="error" role="alert">{paymentError}</p>}
        {cancelError && <p class="error" role="alert">{cancelError}</p>}
        {paymentUnconfirmed && <p role="status">付款結果暫時無法確認，請稍後重新整理本頁；結果確認後訂單狀態會自動更新。</p>}
        {order.status === "paid" && <p role="status">已收到付款，訂單已付款。</p>}
        <p>訂單狀態：<OrderStatus status={order.status} /></p>
        {statusNote && <p>{statusNote}</p>}
        {
          order.status === "shipped" && <p>{shipmentSummary(order.shippedAt, order.trackingNumber)}</p>
        }
        {order.status === "pending_payment" && <section class="payment-callout" aria-label="完成付款">
          <h2>完成付款，準備迎接你的商品</h2>
          <p>付款期限：<time datetime={new Date(order.paymentDeadline).toISOString()}>{formatDateTime(order.paymentDeadline)}</time>（台北時間）</p>
          <p>逾期未付，保留的商品會釋放。付款期限前 2 分鐘內無法再發起付款，請儘早完成。</p>
          <form method="post" action={`/orders/${order.id}/pay`}><button class="pay" type="submit">前往付款</button></form>
        </section>}
        <p>成立時間：{formatDateTime(order.createdAt)}</p>
        <h2>訂單明細</h2>
        <OrderLines lines={order.lines} />
        <p>總金額：<strong>NT$ {priceFormat.format(order.totalTwd)}</strong>（新台幣、含稅、免運）</p>
        {
          order.payments.length > 0 && (
            <>
              <h2>付款嘗試</h2>
              <table>
                <thead>
                  <tr><th>發起時間</th><th>金額</th><th>狀態</th></tr>
                </thead>
                <tbody>
                  {order.payments.map((payment) => (
                    <tr>
                      <td>{formatDateTime(payment.createdAt)}</td>
                      <td>NT$ {priceFormat.format(payment.amountTwd)}</td>
                      <td>
                        {paymentStatusLabel(payment.status)}
                        {refundReasonLabel(payment.refundReason) && <small>（{refundReasonLabel(payment.refundReason)}）</small>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )
        }
        <h2>收件資訊</h2>
        <p>{order.shippingInfo.name}／{order.shippingInfo.phone}</p>
        <p>{order.shippingInfo.address}</p>
        {order.status === "pending_payment" && <form class="cancel" method="post" onsubmit="return confirm('確定要取消這張訂單嗎？取消後無法恢復。')">
          <p>取消後無法恢復。</p><button type="submit">取消訂單</button>
        </form>}
        <p><a href="/orders">回我的訂單</a></p>
      </>
    )
  }
</Layout>

<script>
  import { emptyCart } from "../../cart/cart";
  import { storageOf } from "../../cart/storage";
  import { updateCart } from "../../cart/store";
  import { clearIdempotencyKey, sessionStorageOf } from "../../checkout/idempotency";
  import { takePlacedOrder } from "../../checkout/placed";
  import { parseOrderId } from "../../orders/labels";

  // 剛結帳成功導來這一頁（?placed=1）：只有這張訂單就是結帳頁記下的那張才清空購物車與冪等鍵（清完移除記錄）。
  // 只看網址參數不算數；結帳失敗或重送時兩者都要保留
  if (new URLSearchParams(location.search).get("placed") === "1") {
    const session = sessionStorageOf(window);
    if (takePlacedOrder(session, parseOrderId(location.pathname.split("/").pop()))) {
      updateCart(storageOf(window), window, () => emptyCart);
      clearIdempotencyKey(session);
    }
  }
</script>

<style>
  .payment-callout { padding: var(--space-6); border: 2px solid var(--color-primary); border-radius: var(--radius-lg); background: var(--color-surface); margin-block: var(--space-6); box-shadow: var(--shadow-card); }
  .payment-callout h2 { margin-top: 0; }
  .pay { width: 100%; padding: var(--space-4) var(--space-6); font-weight: 700; font-size: var(--text-lg); }
  .cancel { margin-block: var(--space-8); border-top: 1px solid var(--color-border); }
  .cancel button { color: var(--color-muted); background: var(--color-surface); border-color: var(--color-border); }
  .cancel button:hover { background: var(--color-bg); }
  @media(min-width: 40rem) { .pay { width: auto; min-width: 16rem; } }
</style>
