---
import { env } from "cloudflare:workers";
import { readAccessJwt } from "../../../admin/access-jwt";
import { describeRetryFailure, describeRetryOutcome, parseRetryResult } from "../../../admin/refund";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { formatDateTime, refundAttemptLabel, refundReasonLabel, refundStatusLabel } from "../../../orders/labels";
import { toText } from "../../../shared/form-values";

export const prerender = false;

// 授權完全由 App Worker 驗 JWT 決定；這裡只轉交 header，收到 unauthorized 就顯示 403
const jwt = readAccessJwt(Astro.request, env, import.meta.env.DEV);
let failure: string | undefined;
let unauthorized = false;

// 重試／查證（POST）：明確失敗的直接重送，結果不明的先向閘道查證再決定；成功後 303 回本頁並帶結果
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const result = await env.APP.retryRefund(jwt, { refundId: Number(toText(form.get("refundId"))) });
  if (result.ok) return Astro.redirect(`/admin/refunds?result=${result.data.status}`, 303);
  if (result.reason === "unauthorized") unauthorized = true;
  else failure = describeRetryFailure(result);
}

const listing = unauthorized ? null : await env.APP.listRefundsToHandle(jwt);
if (unauthorized || (listing && !listing.ok)) Astro.response.status = 403;
const saved = parseRetryResult(Astro.url.searchParams);
const notice = saved ? describeRetryOutcome(saved) : null;
const priceFormat = new Intl.NumberFormat("zh-TW");
---

<AdminLayout title="退款待辦">
  {
    !listing?.ok ? (
      <p class="error" role="alert">沒有權限：請確認已通過 Cloudflare Access 登入。</p>
    ) : (
      <>
        {notice && (notice.isError ? <p class="error" role="alert">{notice.text}</p> : <p role="status">{notice.text}</p>)}
        {failure && <p class="error" role="alert">{failure}</p>}
        <p>
          這裡列出所有尚未成功的退款。同一張訂單的退款一次只執行一筆：<strong>結果不明</strong>的退款要先向閘道查證（不會盲目重送），
          期間同單的後筆退款會等待；<strong>明確失敗</strong>的退款額度仍保留，可直接重試，同單的後筆退款不受影響。重試沿用同一筆退款，不會重複退款。
        </p>
        {listing.data.omitted > 0 && <p class="error" role="alert">另有 {listing.data.omitted} 筆待處理的退款未列出。</p>}
        {listing.data.refunds.length === 0 && <p>目前沒有待處理的退款。</p>}
        {listing.data.refunds.length > 0 && (
          <div class="table-scroll" tabindex="0" role="region" aria-label="待處理的退款"><table>
            <thead>
              <tr><th>退款</th><th>訂單</th><th>金額</th><th>狀態</th><th>嘗試紀錄</th><th>操作</th></tr>
            </thead>
            <tbody>
              {listing.data.refunds.map((refund) => (
                <tr>
                  <td data-label="退款">#{refund.id}<br />{refundReasonLabel(refund.reason)}<br />{formatDateTime(refund.createdAt)}</td>
                  <td data-label="訂單"><a href={`/admin/orders/${refund.orderId}`}>#{refund.orderId}</a></td>
                  <td data-label="金額">NT$ {priceFormat.format(refund.amountTwd)}<br /><small>商品款 NT$ {priceFormat.format(refund.goodsTwd)}、運費 NT$ {priceFormat.format(refund.shippingTwd)}</small></td>
                  <td data-label="狀態">
                    <strong class={refund.status === "unknown" || refund.status === "failed" ? "pending" : undefined}>{refundStatusLabel(refund.status)}</strong>
                    {refund.blocked && <><br /><small>同單有另一筆退款結果不明，須先查證那一筆</small></>}
                  </td>
                  <td data-label="嘗試紀錄">
                    {refund.attempts.length === 0 ? "尚未送出" : (
                      <ul class="attempts">
                        {refund.attempts.map((attempt) => (
                          <li>{formatDateTime(attempt.at)} {attempt.actor === "system" ? "系統" : attempt.actor}：{refundAttemptLabel(attempt.action, attempt.outcome)}{attempt.code && `（${attempt.code}）`}</li>
                        ))}
                      </ul>
                    )}
                  </td>
                  <td data-label="操作">
                    <form method="post">
                      <input type="hidden" name="refundId" value={refund.id} />
                      <button type="submit" disabled={refund.blocked} aria-label={`${refund.status === "unknown" ? "查證並重試" : "重試"}退款 #${refund.id}`}>{refund.status === "unknown" ? "查證並重試" : "重試"}</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table></div>
        )}
      </>
    )
  }
</AdminLayout>

<style>
  .pending { color: var(--color-error); }
  .attempts { margin: 0; padding-left: 1.1em; }
</style>
