---
import { env } from "cloudflare:workers";
import { readAccessJwt } from "../../../admin/access-jwt";
import { parseStatusFilter } from "../../../admin/order-form";
import OrderStatus from "../../../orders/OrderStatus.astro";
import OrderCover from "../../../orders/OrderCover.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { formatDateTime, ORDER_STATUS_CODES, orderStatusLabel } from "../../../orders/labels";

export const prerender = false;

// 授權完全由 App Worker 驗 JWT 決定；這裡只轉交 header，收到 unauthorized 就顯示 403
const jwt = readAccessJwt(Astro.request, env, import.meta.env.DEV);
const status = parseStatusFilter(Astro.url.searchParams.get("status"));
const orders = await env.APP.listOrdersForAdmin(jwt, status === undefined ? {} : { status });
if (!orders.ok) Astro.response.status = 403;
const priceFormat = new Intl.NumberFormat("zh-TW");
---

<AdminLayout title="訂單管理">
  {
    !orders.ok ? (
      <p class="error" role="alert">沒有權限：請確認已通過 Cloudflare Access 登入。</p>
    ) : (
      <>
        <form method="get" class="admin-filter">
          <label class="filter-field">
            訂單狀態
            <select name="status">
              <option value="" selected={status === undefined}>全部訂單狀態</option>
              {ORDER_STATUS_CODES.map((code) => (
                <option value={code} selected={status === code}>{orderStatusLabel(code)}</option>
              ))}
            </select>
          </label>
          <div class="filter-actions">
            <button type="submit" class="btn-filter-submit">篩選</button>
            {status !== undefined && (
              <a href="/admin/orders" class="btn-filter-reset">清除條件</a>
            )}
          </div>
        </form>
        <p>只顯示最新 200 筆訂單。</p>
        {orders.data.length === 0 && <p>沒有符合的訂單。</p>}
        {
          orders.data.length > 0 && (
            <div class="table-scroll admin-orders" tabindex="0" role="region" aria-label="管理資料表"><table>
              <thead>
                <tr><th>訂單</th><th>商品</th><th>顧客</th><th>成立時間</th><th>訂單狀態</th><th>總金額</th><th>付款</th></tr>
              </thead>
              <tbody>
                {orders.data.map((order) => (
                  <tr>
                    <td data-label="訂單"><a href={`/admin/orders/${order.id}`}>#{order.id}</a></td>
                    <td data-label="商品"><ul class="order-products">{order.lines.map(line => <li><span class="admin-order-cover"><OrderCover cover={line.cover} name={line.productName} /></span><span>{line.productName} × {line.quantity}</span></li>)}</ul></td>
                    <td data-label="顧客" class="admin-order-email"><span>{order.customerEmail.split(/(?=[@.])/).map(part => <>{part}<wbr /></>)}</span></td>
                    <td data-label="成立時間">{formatDateTime(order.createdAt)}</td>
                    <td data-label="訂單狀態"><OrderStatus status={order.status} /></td>
                    <td data-label="總金額">NT$ {priceFormat.format(order.totalTwd)}</td>
                    <td data-label="付款">{order.needsAttention ? <strong class="error">需要處理</strong> : "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table></div>
          )
        }
      </>
    )
  }
</AdminLayout>
