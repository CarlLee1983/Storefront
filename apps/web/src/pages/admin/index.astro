---
import { env } from "cloudflare:workers";
import { readAccessJwt } from "../../admin/access-jwt";
import { describeFailure } from "../../admin/failure";
import { dispatchProductForm, FEATURE_INTENT, UNFEATURE_INTENT } from "../../admin/product-form";
import AdminLayout from "../../layouts/AdminLayout.astro";

export const prerender = false;

// 授權完全由 App Worker 驗 JWT 決定；這裡只轉交 header，收到 unauthorized 就顯示 403
const jwt = readAccessJwt(Astro.request, env, import.meta.env.DEV);
let unauthorized = false;
let listingError = "";
let stockFailureId: number | undefined;
const LISTING_FAILED = "操作失敗，請稍後再試";

/** 清單上按鈕（上下架、精選）的失敗：未授權交給頁面回 403，其餘顯示在清單上方。 */
function failListingAction(result: { reason: string; fields?: Record<string, string[]> }) {
  if (result.reason === "unauthorized") unauthorized = true;
  else listingError = describeFailure(result, LISTING_FAILED).message;
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const dispatch = dispatchProductForm(form);
  if (dispatch.kind === "invalid") {
    // 被竄改或不認得的表單：不呼叫任何 RPC
    Astro.response.status = 400;
    listingError = LISTING_FAILED;
  } else if (dispatch.kind === "listing") {
    // 清單上的下架／重新上架按鈕
    const { action, id } = dispatch;
    const result =
      action === "unlist" ? await env.APP.unlistProduct(jwt, { id }) : await env.APP.relistProduct(jwt, { id });
    if (result.ok) return Astro.redirect(`/admin?saved=${action}`, 303);
    failListingAction(result);
  } else if (dispatch.kind === "featured") {
    // 清單上的精選切換
    const result = await env.APP.setProductFeatured(jwt, { id: dispatch.id, featured: dispatch.featured });
    if (result.ok) return Astro.redirect(`/admin?saved=${dispatch.featured ? FEATURE_INTENT : UNFEATURE_INTENT}`, 303);
    failListingAction(result);
  } else if (dispatch.kind === "stock") {
    // 清單上的庫存調整（增減量）
    const result = await env.APP.adjustStock(jwt, dispatch.input);
    if (result.ok) return Astro.redirect("/admin?saved=stock", 303);
    if (result.reason === "unauthorized") unauthorized = true;
    else {
      const described = describeFailure(result, LISTING_FAILED);
      listingError = [described.message, ...(described.fields.delta ?? [])].join("：");
      stockFailureId = dispatch.input.id;
    }
  }
}

const products = unauthorized ? null : await env.APP.listProductsForAdmin(jwt);
if (unauthorized || (products && !products.ok)) Astro.response.status = 403;
const SAVED_MESSAGES: Record<string, string> = {
  updated: "已儲存商品。",
  unlist: "已下架商品。",
  relist: "已重新上架商品。",
  [FEATURE_INTENT]: "已標為精選商品。",
  [UNFEATURE_INTENT]: "已取消精選。",
  stock: "已調整庫存。",
};
const savedMessage = SAVED_MESSAGES[Astro.url.searchParams.get("saved") ?? ""];
const priceFormat = new Intl.NumberFormat("zh-TW");
---

<AdminLayout title="商品管理">
  {
    Astro.response.status === 403 ? (
      <p class="error" role="alert">沒有權限：請確認已通過 Cloudflare Access 登入。</p>
    ) : (
      <>
        <p><a href="/admin/products/new">新增商品</a></p>
        {savedMessage && <p role="status">{savedMessage}</p>}
        {listingError && <p id="listing-error" class="error" role="alert">{listingError}</p>}
        {products?.ok && products.data.length === 0 && <p>目前沒有商品。</p>}
        {
          products?.ok && products.data.length > 0 && (
            <div class="table-scroll admin-products" tabindex="0" role="region" aria-label="管理資料表"><table>
              <thead>
                <tr><th>封面</th><th>名稱</th><th>分類</th><th>售價</th><th>原價</th><th>在庫數</th><th>保留數</th><th>可售數量</th><th>狀態</th><th>精選</th><th>操作</th></tr>
              </thead>
              <tbody>
                {products.data.map((p) => (
                  <tr>
                    <td data-label="封面">{p.cover ? <img src={`/images/${p.cover.variants[0]!.key}`} width="64" height="64" style="object-fit: cover; border-radius: 0.25rem" alt={`${p.name}的封面`} loading="lazy" /> : <span>尚無圖片</span>}</td>
                    <td>{p.name}</td>
                    <td data-label="分類">{p.category?.name ?? "未分類"}</td>
                    <td data-label="售價">{priceFormat.format(p.priceTwd)}</td>
                    <td data-label="原價">{p.compareAtPriceTwd === null ? "—" : priceFormat.format(p.compareAtPriceTwd)}</td>
                    <td data-label="在庫數">{p.onHand}</td>
                    <td data-label="保留數">{p.reserved}</td>
                    <td data-label="可售數量">{p.available}</td>
                    <td data-label="狀態">{p.listed ? "上架中" : "已下架"}</td>
                    <td data-label="精選">
                      {p.featured ? "精選" : "—"}
                      <form method="post" class="inline">
                        <input type="hidden" name="id" value={p.id} />
                        <input type="hidden" name="intent" value={p.featured ? UNFEATURE_INTENT : FEATURE_INTENT} />
                        <button type="submit" aria-label={`${p.featured ? "取消精選" : "標為精選"}：${p.name}`}>{p.featured ? "取消精選" : "標為精選"}</button>
                      </form>
                    </td>
                    <td data-label="操作">
                      <div class="admin-actions">
                        <a href={`/admin/products/${p.id}`}>編輯</a>
                        <form method="post" class="inline">
                          <input type="hidden" name="id" value={p.id} />
                          <input type="hidden" name="intent" value={p.listed ? "unlist" : "relist"} />
                          <button type="submit">{p.listed ? "下架" : "重新上架"}</button>
                        </form>
                        <form method="post" class="inline">
                          <input type="hidden" name="id" value={p.id} />
                          <input type="hidden" name="intent" value="adjust-stock" />
                          <input name="delta" type="text" inputmode="numeric" pattern="[+-]?\d+" placeholder="+20 或 -5" aria-label={`${p.name}的庫存增減量`} aria-describedby={stockFailureId === p.id ? "listing-error" : undefined} aria-invalid={stockFailureId === p.id ? "true" : undefined} required />
                          <button type="submit">調整庫存</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table></div>
          )
        }
      </>
    )
  }
</AdminLayout>
