---
import { env } from "cloudflare:workers";
import { readAccessJwt } from "../../admin/access-jwt";
import { describeFailure } from "../../admin/failure";
import { dispatchProductForm, FEATURE_INTENT, UNFEATURE_INTENT } from "../../admin/product-form";
import { summarizeVariants } from "../../admin/variant-summary";
import AdminLayout from "../../layouts/AdminLayout.astro";

export const prerender = false;

// 授權完全由 App Worker 驗 JWT 決定；這裡只轉交 header，收到 unauthorized 就顯示 403
const jwt = readAccessJwt(Astro.request, env, import.meta.env.DEV);
let unauthorized = false;
let listingError = "";
let stockFailureVariantId: number | undefined;
const LISTING_FAILED = "操作失敗，請稍後再試";

/** 清單上按鈕（上下架、精選）的失敗：未授權交給頁面回 403，其餘顯示在清單上方。 */
function failListingAction(result: { reason: string; fields?: Record<string, string[]> }) {
  if (result.reason === "unauthorized") unauthorized = true;
  else listingError = describeFailure(result, LISTING_FAILED).message;
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const dispatch = dispatchProductForm(form);
  if (dispatch.kind === "invalid") {
    // 被竄改或不認得的表單：不呼叫任何 RPC
    Astro.response.status = 400;
    listingError = LISTING_FAILED;
  } else if (dispatch.kind === "listing") {
    // 清單上的下架／重新上架按鈕
    const { action, id } = dispatch;
    const result =
      action === "unlist" ? await env.APP.unlistProduct(jwt, { id }) : await env.APP.relistProduct(jwt, { id });
    if (result.ok) return Astro.redirect(`/admin?saved=${action}`, 303);
    failListingAction(result);
  } else if (dispatch.kind === "featured") {
    // 清單上的精選切換
    const result = await env.APP.setProductFeatured(jwt, { id: dispatch.id, featured: dispatch.featured });
    if (result.ok) return Astro.redirect(`/admin?saved=${dispatch.featured ? FEATURE_INTENT : UNFEATURE_INTENT}`, 303);
    failListingAction(result);
  } else if (dispatch.kind === "stock") {
    // 清單上的庫存調整（增減量）
    const result = await env.APP.adjustStock(jwt, dispatch.input);
    if (result.ok) return Astro.redirect("/admin?saved=stock", 303);
    if (result.reason === "unauthorized") unauthorized = true;
    else {
      const described = describeFailure(result, LISTING_FAILED);
      listingError = [described.message, ...(described.fields.delta ?? [])].join("：");
      stockFailureVariantId = dispatch.input.variantId;
    }
  }
}

const [productsResult, categoriesResult] = await Promise.all([
  unauthorized ? Promise.resolve(null) : env.APP.listProductsForAdmin(jwt),
  unauthorized ? Promise.resolve(null) : env.APP.listCategoriesForAdmin(jwt),
]);
const products = productsResult;
const categories = categoriesResult?.ok ? categoriesResult.data : [];
if (unauthorized || (products && !products.ok)) Astro.response.status = 403;
const SAVED_MESSAGES: Record<string, string> = {
  updated: "已儲存商品。",
  unlist: "已下架商品。",
  relist: "已重新上架商品。",
  [FEATURE_INTENT]: "已標為精選商品。",
  [UNFEATURE_INTENT]: "已取消精選。",
  stock: "已調整庫存。",
};
const savedMessage = SAVED_MESSAGES[Astro.url.searchParams.get("saved") ?? ""];
const priceFormat = new Intl.NumberFormat("zh-TW");

// 篩選處理：狀態、分類、關鍵字搜尋
const filterStatus = Astro.url.searchParams.get("status") ?? "";
const filterCategory = Astro.url.searchParams.get("category") ?? "";
const filterQuery = (Astro.url.searchParams.get("q") ?? "").trim().toLowerCase();

let filteredProducts = products?.ok ? products.data : [];
if (filterStatus === "listed") {
  filteredProducts = filteredProducts.filter((p) => p.listed);
} else if (filterStatus === "unlisted") {
  filteredProducts = filteredProducts.filter((p) => !p.listed);
} else if (filterStatus === "featured") {
  filteredProducts = filteredProducts.filter((p) => p.featured);
}

if (filterCategory) {
  filteredProducts = filteredProducts.filter((p) => p.category && String(p.category.id) === filterCategory);
}

if (filterQuery) {
  filteredProducts = filteredProducts.filter((p) => p.name.toLowerCase().includes(filterQuery));
}

// 分頁處理：每頁 15 筆
const PAGE_SIZE = 15;
const totalProducts = filteredProducts.length;
const totalPages = Math.max(1, Math.ceil(totalProducts / PAGE_SIZE));
const requestedPage = Number(Astro.url.searchParams.get("page") ?? "1");
const currentPage = Number.isInteger(requestedPage) && requestedPage >= 1 && requestedPage <= totalPages ? requestedPage : 1;
const paginatedProducts = filteredProducts.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

function paginationUrl(p: number) {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (p <= 1) params.delete("page");
  else params.set("page", String(p));
  const qs = params.toString();
  return qs ? `/admin?${qs}` : "/admin";
}
---

<AdminLayout title="商品管理">
  {
    Astro.response.status === 403 ? (
      <p class="error" role="alert">沒有權限：請確認已通過 Cloudflare Access 登入。</p>
    ) : (
      <>
        <div class="admin-toolbar">
          <a class="button-create" href="/admin/products/new">＋ 新增商品</a>
        </div>
        {savedMessage && <p role="status">{savedMessage}</p>}
        {listingError && <p id="listing-error" class="error" role="alert">{listingError}</p>}
        
        {products?.ok && products.data.length > 0 && (
          <form method="get" class="admin-filter">
            <label class="filter-field">
              搜尋商品名稱
              <input name="q" value={filterQuery} placeholder="輸入名稱關鍵字..." />
            </label>
            <label class="filter-field">
              分類
              <select name="category">
                <option value="" selected={filterCategory === ""}>全部分類</option>
                {categories.map((c) => (
                  <option value={String(c.id)} selected={filterCategory === String(c.id)}>{c.name}</option>
                ))}
              </select>
            </label>
            <label class="filter-field">
              商品狀態
              <select name="status">
                <option value="" selected={filterStatus === ""}>全部狀態</option>
                <option value="listed" selected={filterStatus === "listed"}>上架中</option>
                <option value="unlisted" selected={filterStatus === "unlisted"}>已下架</option>
                <option value="featured" selected={filterStatus === "featured"}>僅精選</option>
              </select>
            </label>
            <div class="filter-actions">
              <button type="submit" class="btn-filter-submit">篩選</button>
              {(filterStatus || filterCategory || filterQuery) && (
                <a href="/admin" class="btn-filter-reset">清除條件</a>
              )}
            </div>
          </form>
        )}

        {products?.ok && products.data.length === 0 && (
          <div class="admin-empty-state">
            <p>目前還沒有任何商品。</p>
            <a class="button-create" href="/admin/products/new">＋ 建立第一件商品</a>
          </div>
        )}
        {products?.ok && products.data.length > 0 && filteredProducts.length === 0 && (
          <div class="admin-empty-state">
            <p>沒有符合篩選條件的商品。</p>
            <a href="/admin" class="btn-action">清除篩選條件</a>
          </div>
        )}
        {
          products?.ok && filteredProducts.length > 0 && (
            <>
              <div class="table-scroll admin-products" tabindex="0" role="region" aria-label="管理資料表"><table>
                <thead>
                  <tr>
                    <th class="col-cover">封面</th>
                    <th class="col-name">商品名稱</th>
                    <th class="col-category">分類</th>
                    <th class="col-num">售價</th>
                    <th class="col-num">原價</th>
                    <th class="col-num">在庫</th>
                    <th class="col-num">保留</th>
                    <th class="col-num">可售</th>
                    <th class="col-status">狀態</th>
                    <th class="col-featured">精選</th>
                    <th class="col-actions">操作</th>
                  </tr>
                </thead>
                <tbody>
                  {paginatedProducts.map((p) => {
                    const stock = summarizeVariants(p);
                    return (
                    <tr class:list={[{ "is-unlisted": !p.listed }]}>
                      <td class="col-cover" data-label="封面">
                        <div class="product-cover-cell">
                          {p.cover ? (
                            <img src={`/images/${p.cover.variants[0]!.key}`} width="48" height="48" class="admin-product-thumb" alt={`${p.name}的封面`} loading="lazy" />
                          ) : (
                            <span class="thumb-empty">無圖</span>
                          )}
                        </div>
                      </td>
                      <td class="col-name" data-label="名稱">
                        <div class="product-name-cell">
                          <a href={`/admin/products/${p.id}`} class="product-title-link">{p.name}</a>
                          {p.featured && <span class="badge-featured-mini">精選</span>}
                        </div>
                      </td>
                      <td class="col-category" data-label="分類"><span class="badge-category">{p.category?.name ?? "未分類"}</span></td>
                      <td class="col-num cell-price" data-label="售價">{stock.multiple && stock.minPriceTwd !== stock.maxPriceTwd ? `NT$ ${priceFormat.format(stock.minPriceTwd)} – ${priceFormat.format(stock.maxPriceTwd)}` : `NT$ ${priceFormat.format(stock.minPriceTwd)}`}</td>
                      <td class="col-num cell-was-price" data-label="原價">{stock.multiple || p.compareAtPriceTwd === null ? "—" : `NT$ ${priceFormat.format(p.compareAtPriceTwd)}`}</td>
                      <td class="col-num" data-label="在庫數">{stock.onHand}</td>
                      <td class="col-num" data-label="保留數">{stock.reserved}</td>
                      <td class="col-num cell-available" data-label="可售數量">
                        <span class:list={["stock-pill", { "is-zero": stock.available === 0, "is-low": stock.available > 0 && stock.available <= 5 }]}>
                          {stock.available}
                        </span>
                      </td>
                      <td class="col-status" data-label="狀態">
                        <span class:list={["status-badge", p.listed ? "is-listed" : "is-unlisted"]}>
                          {p.listed ? "上架中" : "已下架"}
                        </span>
                      </td>
                      <td class="col-featured" data-label="精選">
                        <form method="post" class="inline">
                          <input type="hidden" name="id" value={p.id} />
                          <input type="hidden" name="intent" value={p.featured ? UNFEATURE_INTENT : FEATURE_INTENT} />
                          <button type="submit" class:list={["btn-toggle-featured", { "is-active": p.featured }]} aria-label={`${p.featured ? "取消精選" : "標為精選"}：${p.name}`}>
                            {p.featured ? "已精選" : "設為精選"}
                          </button>
                        </form>
                      </td>
                      <td class="col-actions" data-label="操作">
                        <div class="admin-actions">
                          <a href={`/admin/products/${p.id}`} class="btn-action">編輯</a>
                          <form method="post" class="inline">
                            <input type="hidden" name="id" value={p.id} />
                            <input type="hidden" name="intent" value={p.listed ? "unlist" : "relist"} />
                            <button type="submit" class="btn-action">{p.listed ? "下架" : "重新上架"}</button>
                          </form>
                          {stock.multiple ? <a href={`/admin/products/${p.id}#variants-heading`} class="btn-action">管理變體庫存</a> : <form method="post" class="inline inline-stock-adjust">
                            <input type="hidden" name="variantId" value={p.defaultVariantId} />
                            <input type="hidden" name="intent" value="adjust-stock" />
                            <input name="delta" type="text" inputmode="numeric" pattern="[+-]?\d+" placeholder="±增減" aria-label={`${p.name}的庫存增減量`} aria-describedby={stockFailureVariantId === p.defaultVariantId ? "listing-error" : undefined} aria-invalid={stockFailureVariantId === p.defaultVariantId ? "true" : undefined} required />
                            <button type="submit" class="btn-action">調整庫存</button>
                          </form>}
                        </div>
                      </td>
                    </tr>
                    );
                  })}
                </tbody>
              </table></div>
              {totalPages > 1 && (
                <nav class="admin-pagination" aria-label="商品列表分頁">
                  <span class="pagination-info">
                    共 {totalProducts} 件商品，顯示第 {(currentPage - 1) * PAGE_SIZE + 1}–{Math.min(currentPage * PAGE_SIZE, totalProducts)} 件
                  </span>
                  <div class="pagination-controls">
                    <a
                      href={currentPage > 1 ? paginationUrl(currentPage - 1) : undefined}
                      class:list={["pagination-btn", { "is-disabled": currentPage <= 1 }]}
                      aria-disabled={currentPage <= 1 ? "true" : undefined}
                      tabindex={currentPage <= 1 ? -1 : undefined}
                    >
                      ← 上一頁
                    </a>
                    <div class="pagination-pages">
                      {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                        <a
                          href={paginationUrl(p)}
                          class:list={["pagination-page", { "is-current": p === currentPage }]}
                          aria-current={p === currentPage ? "page" : undefined}
                        >
                          {p}
                        </a>
                      ))}
                    </div>
                    <a
                      href={currentPage < totalPages ? paginationUrl(currentPage + 1) : undefined}
                      class:list={["pagination-btn", { "is-disabled": currentPage >= totalPages }]}
                      aria-disabled={currentPage >= totalPages ? "true" : undefined}
                      tabindex={currentPage >= totalPages ? -1 : undefined}
                    >
                      下一頁 →
                    </a>
                  </div>
                </nav>
              )}
            </>
          )
        }
      </>
    )
  }
</AdminLayout>
