---
import { env } from "cloudflare:workers";
import { MAX_SLUG_LENGTH, SLUG_PATTERN } from "@storefront/app/category-slug";
import { readAccessJwt } from "../../admin/access-jwt";
import {
  describeFailure,
  dispatchProductForm,
  productFormToInput,
  type Failure,
} from "../../admin/product-form";
import { formToRecord } from "../../shared/form-values";
import Layout from "../../layouts/Layout.astro";

export const prerender = false;

// 授權完全由 App Worker 驗 JWT 決定；這裡只轉交 header，收到 unauthorized 就顯示 403
const jwt = readAccessJwt(Astro.request, env, import.meta.env.DEV);
let failure: Failure | undefined;
let submitted: Record<string, string> = {};
let unauthorized = false;
let listingError = "";
let stockFailure: (Failure & { id: number }) | undefined;
let categoryFailure: Failure | undefined;
let categorySubmitted: Record<string, string> = {};
const LISTING_FAILED = "操作失敗，請稍後再試";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const dispatch = dispatchProductForm(form);
  if (dispatch.kind === "invalid") {
    // 被竄改或不認得的表單：不呼叫任何 RPC
    Astro.response.status = 400;
    listingError = LISTING_FAILED;
  } else if (dispatch.kind === "listing") {
    // 清單上的下架／重新上架按鈕
    const { action, id } = dispatch;
    const result =
      action === "unlist" ? await env.APP.unlistProduct(jwt, { id }) : await env.APP.relistProduct(jwt, { id });
    if (result.ok) return Astro.redirect(`/admin?saved=${action}`, 303);
    if (result.reason === "unauthorized") unauthorized = true;
    else listingError = describeFailure(result, LISTING_FAILED).message;
  } else if (dispatch.kind === "create-category") {
    categorySubmitted = formToRecord(form);
    const result = await env.APP.createCategory(jwt, dispatch.input);
    if (result.ok) return Astro.redirect("/admin?saved=category", 303);
    if (result.reason === "unauthorized") unauthorized = true;
    else categoryFailure = describeFailure(result, "建立分類失敗，請稍後再試");
  } else if (dispatch.kind === "stock") {
    // 清單上的庫存調整（增減量）
    const result = await env.APP.adjustStock(jwt, dispatch.input);
    if (result.ok) return Astro.redirect("/admin?saved=stock", 303);
    if (result.reason === "unauthorized") unauthorized = true;
    else {
      const described = describeFailure(result, LISTING_FAILED);
      listingError = described.message;
      // 欄位錯誤（例如增減量不可為 0）顯示在該列的輸入框旁
      stockFailure = { ...described, id: dispatch.input.id };
    }
  } else {
    submitted = formToRecord(form);
    const result = await env.APP.createProduct(jwt, productFormToInput(form));
    if (result.ok) return Astro.redirect("/admin?saved=created", 303);
    if (result.reason === "unauthorized") unauthorized = true;
    else failure = describeFailure(result, "新增商品失敗，請稍後再試");
  }
}

const products = unauthorized ? null : await env.APP.listProductsForAdmin(jwt);
const categories = unauthorized ? null : await env.APP.listCategoriesForAdmin(jwt);
if (unauthorized || (products && !products.ok)) Astro.response.status = 403;
const SAVED_MESSAGES: Record<string, string> = {
  created: "已新增商品。",
  updated: "已儲存商品。",
  unlist: "已下架商品。",
  relist: "已重新上架商品。",
  stock: "已調整庫存。",
  category: "已建立分類。",
};
const savedMessage = SAVED_MESSAGES[Astro.url.searchParams.get("saved") ?? ""];
const priceFormat = new Intl.NumberFormat("zh-TW");
---

<Layout title="商品管理" admin>
  {
    Astro.response.status === 403 ? (
      <p class="error" role="alert">沒有權限：請確認已通過 Cloudflare Access 登入。</p>
    ) : (
      <>
        {savedMessage && <p role="status">{savedMessage}</p>}
        {listingError && <p class="error" role="alert">{listingError}</p>}
        {products?.ok && products.data.length === 0 && <p>目前沒有商品。</p>}
        {
          products?.ok && products.data.length > 0 && (
            <div class="table-scroll" tabindex="0" role="region" aria-label="管理資料表"><table>
              <thead>
                <tr><th>封面</th><th>名稱</th><th>說明</th><th>分類</th><th>單價（NT$）</th><th>在庫數</th><th>保留數</th><th>可售數量</th><th>狀態</th><th></th></tr>
              </thead>
              <tbody>
                {products.data.map((p) => (
                  <tr>
                    <td>{p.cover ? <img src={`/images/${p.cover.variants[0]!.key}`} width="64" height="64" style="object-fit: cover; border-radius: 0.25rem" alt={`${p.name}的封面`} loading="lazy" /> : <span>尚無圖片</span>}</td>
                    <td>{p.name}</td>
                    <td>{p.description}</td>
                    <td>{p.category?.name ?? "未分類"}</td>
                    <td>{priceFormat.format(p.priceTwd)}</td>
                    <td>{p.onHand}</td>
                    <td>{p.reserved}</td>
                    <td>{p.available}</td>
                    <td>{p.listed ? "上架中" : "已下架"}</td>
                    <td>
                      <a href={`/admin/products/${p.id}`}>編輯</a>
                      <form method="post" class="inline">
                        <input type="hidden" name="id" value={p.id} />
                        <input type="hidden" name="intent" value={p.listed ? "unlist" : "relist"} />
                        <button type="submit">{p.listed ? "下架" : "重新上架"}</button>
                      </form>
                      <form method="post" class="inline">
                        <input type="hidden" name="id" value={p.id} />
                        <input type="hidden" name="intent" value="adjust-stock" />
                        <input name="delta" type="text" inputmode="numeric" pattern="[+-]?\d+" placeholder="+20 或 -3" aria-label={`${p.name}的庫存增減量`} required />
                        {stockFailure?.id === p.id && stockFailure.fields.delta?.map((m) => <span class="error">{m}</span>)}
                        <button type="submit">調整庫存</button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table></div>
          )
        }
        <h2>分類</h2>
        {categories?.ok && categories.data.length === 0 && <p>目前沒有分類。商品需要先有分類才能上架。</p>}
        {
          categories?.ok && categories.data.length > 0 && (
            <div class="table-scroll" tabindex="0" role="region" aria-label="分類資料表"><table>
              <thead>
                <tr><th>名稱</th><th>代稱</th><th>商品數</th></tr>
              </thead>
              <tbody>
                {categories.data.map((c) => (
                  <tr><td>{c.name}</td><td>{c.slug}</td><td>{c.productCount}</td></tr>
                ))}
              </tbody>
            </table></div>
          )
        }
        <h3>新增分類</h3>
        {categoryFailure && <p class="error" role="alert">{categoryFailure.message}</p>}
        <form method="post">
          <input type="hidden" name="intent" value="create-category" />
          <label>
            分類名稱
            <input name="categoryName" value={categorySubmitted.categoryName ?? ""} required />
            {categoryFailure?.fields.name?.map((m) => <span class="error">{m}</span>)}
          </label>
          <label>
            分類說明（一行）
            <input name="categoryDescription" value={categorySubmitted.categoryDescription ?? ""} required />
            {categoryFailure?.fields.description?.map((m) => <span class="error">{m}</span>)}
          </label>
          <label>
            網址代稱（小寫英文、數字與連字號，建立後不能修改）
            <input name="categorySlug" value={categorySubmitted.categorySlug ?? ""} required pattern={SLUG_PATTERN.source} maxlength={MAX_SLUG_LENGTH} />
            {categoryFailure?.fields.slug?.map((m) => <span class="error">{m}</span>)}
          </label>
          <button type="submit">建立分類</button>
        </form>
        <h2>新增商品</h2>
        {failure && <p class="error" role="alert">{failure.message}</p>}
        <form method="post">
          <label>
            名稱
            <input name="name" value={submitted.name ?? ""} required />
            {failure?.fields.name?.map((m) => <span class="error">{m}</span>)}
          </label>
          <label>
            說明
            <textarea name="description" rows="3">{submitted.description ?? ""}</textarea>
            {failure?.fields.description?.map((m) => <span class="error">{m}</span>)}
          </label>
          <label>
            單價（新台幣整數元）
            <input name="priceTwd" type="number" min="1" step="1" value={submitted.priceTwd ?? ""} required />
            {failure?.fields.priceTwd?.map((m) => <span class="error">{m}</span>)}
          </label>
          <button type="submit">新增商品</button>
        </form>
      </>
    )
  }
</Layout>
