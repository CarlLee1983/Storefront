---
import { env } from "cloudflare:workers";
import { readAccessJwt } from "../../../admin/access-jwt";
import { describeFailure, type Failure } from "../../../admin/failure";
import { parseProductId, productUpdateFormToInput } from "../../../admin/product-form";
import { formToRecord } from "../../../shared/form-values";
import AdminLayout from "../../../layouts/AdminLayout.astro";

export const prerender = false;

// 授權完全由 App Worker 驗 JWT 決定；這裡只轉交 header，收到 unauthorized 就顯示 403
const jwt = readAccessJwt(Astro.request, env, import.meta.env.DEV);
const id = parseProductId(Astro.params.id);
let failure: Failure | undefined;
let submitted: Record<string, string> = {};
let unauthorized = false;

if (id !== null && Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  submitted = formToRecord(form);
  const result = await env.APP.updateProduct(jwt, productUpdateFormToInput(form, id));
  if (result.ok) return Astro.redirect("/admin?saved=updated", 303);
  if (result.reason === "unauthorized") unauthorized = true;
  else failure = describeFailure(result, "儲存商品失敗，請稍後再試");
}

const categories = id === null || unauthorized ? null : await env.APP.listCategoriesForAdmin(jwt);
const found = id === null || unauthorized ? null : await env.APP.getProductForAdmin(jwt, { id });
if (unauthorized || (found && !found.ok && found.reason === "unauthorized")) Astro.response.status = 403;
const product = found?.ok ? found.data : undefined;
if (Astro.response.status !== 403 && !product) Astro.response.status = 404;
const values = {
  name: product?.name ?? "",
  description: product?.description ?? "",
  priceTwd: String(product?.priceTwd ?? ""),
  compareAtPriceTwd: String(product?.compareAtPriceTwd ?? ""),
  categoryId: product?.category ? String(product.category.id) : "",
  ...submitted,
};
---

<AdminLayout title="編輯商品">
  {
    Astro.response.status === 403 ? (
      <p class="error" role="alert">沒有權限：請確認已通過 Cloudflare Access 登入。</p>
    ) : Astro.response.status === 404 ? (
      <p class="error" role="alert">找不到這個商品。</p>
    ) : (
      <>
        {Astro.url.searchParams.get("saved") === "created" && <p role="status">已新增商品。</p>}
        {failure && <p class="error" role="alert">{failure.message}</p>}
        <div class="admin-card-section">
          <h2>基本資訊</h2>
          <form method="post">
            <label>
              名稱
              <input name="name" value={values.name} required />
              {failure?.fields.name?.map((m) => <span class="error">{m}</span>)}
            </label>
            <label>
              說明
              <textarea name="description" rows="3">{values.description}</textarea>
              {failure?.fields.description?.map((m) => <span class="error">{m}</span>)}
            </label>
            <div class="admin-form-grid">
              <label>
                單價（新台幣整數元）
                <input name="priceTwd" type="number" min="1" step="1" value={values.priceTwd} required />
                {failure?.fields.priceTwd?.map((m) => <span class="error">{m}</span>)}
              </label>
              <label>
                原價（選填）
                <input name="compareAtPriceTwd" type="number" min="1" step="1" value={values.compareAtPriceTwd} aria-describedby="compare-at-hint" />
                {failure?.fields.compareAtPriceTwd?.map((m) => <span class="error">{m}</span>)}
              </label>
            </div>
            <p id="compare-at-hint"><small>填寫後商品以特價呈現，必須高於售價；清空即結束特價。</small></p>
            {/* 標籤文字用 for 關聯：巢狀在 label 裡的話，所有選項文字都會變成它的名稱 */}
            <label for="category-id">分類</label>
            <select id="category-id" name="categoryId">
              <option value="" selected={values.categoryId === ""}>未分類</option>
              {categories?.ok && categories.data.map((c) => <option value={String(c.id)} selected={values.categoryId === String(c.id)}>{c.name}</option>)}
            </select>
            {failure?.fields.categoryId?.map((m) => <span class="error">{m}</span>)}
            <p><small>商品必須有分類才能上架。</small></p>
            <div class="admin-actions">
              <button type="submit" class="button-primary">儲存變更</button>
              <a href="/admin">取消</a>
            </div>
          </form>
        </div>
        <section aria-labelledby="image-heading" class="admin-card-section">
          <h2 id="image-heading">商品圖片</h2>
          <p>先上傳商品圖片才能上架。每件商品最多 8 張，第一張是封面。</p>
          <p id="gallery-help">拖曳商品圖片，或使用「上移」「下移」按鈕調整順序，排第一張即為封面。排序會立即儲存。</p>
          <ul id="product-images" aria-describedby="gallery-help" data-images={JSON.stringify(product?.images ?? [])} data-product-name={product?.name} data-endpoint={`/admin/products/${id}/gallery`}>
            {product?.images.map((image, index) => <li data-image-id={image.id}>
              <img src={`/images/${image.variants[0]!.key}`} width={image.variants[0]!.width} height={image.variants[0]!.height} alt={`${product.name}的商品圖片 ${index + 1}`} loading="lazy" />
              <span>{index === 0 ? "封面" : `商品圖片 ${index + 1}`}</span>
            </li>)}
          </ul>
          <noscript><p>上傳與排序商品圖片需要啟用 JavaScript。</p></noscript>
          <form id="image-upload" action={`/admin/products/${id}/images`} data-product-name={product?.name}>
            <label>商品圖片（JPEG、PNG 或 WebP，20 MB 以內）<input type="file" name="photo" accept="image/jpeg,image/png,image/webp" multiple required disabled /></label>
            <p>可一次選取多張。圖片會在瀏覽器縮放成 WebP，不保存原圖。</p>
            <button type="submit" disabled>上傳商品圖片</button>
          </form>
          <p id="image-status" role="status" aria-live="polite"></p>
          <p id="image-error" class="error" role="alert" hidden></p>
          <button type="button" id="gallery-refresh" disabled>重新載入商品圖片</button>
          <p><a href="/admin">回商品管理</a></p>
        </section>
      </>
    )
  }
</AdminLayout>

<script>
  import { errorMessage, readResult, uploadImage } from "../../../images/client";
  import type { ProductImage } from "@storefront/app/product-images";
  const form = document.querySelector<HTMLFormElement>("#image-upload");
  if (form) {
    const list = document.querySelector<HTMLUListElement>("#product-images")!;
    const input = form.querySelector<HTMLInputElement>('input[type="file"]')!;
    const uploadButton = form.querySelector<HTMLButtonElement>("button")!;
    const refreshButton = document.querySelector<HTMLButtonElement>("#gallery-refresh")!;
    const status = document.querySelector<HTMLElement>("#image-status")!;
    const error = document.querySelector<HTMLElement>("#image-error")!;
    let images: ProductImage[] = JSON.parse(list.dataset.images!);
    let busy = false;
    let draggedId: string | undefined;
    // Keep each file's identity and completed progress across partial/lost-response retries.
    const selection = () => Array.from(input.files ?? []).map(file => ({ file, uploadId: crypto.randomUUID() }));
    // Retain even a selection populated before this module finished loading.
    let pending: Array<{ file: File; uploadId: string }> = selection();
    input.addEventListener("change", () => { pending = selection(); });
    function setBusy(value: boolean) {
      busy = value;
      uploadButton.disabled = input.disabled = refreshButton.disabled = value;
      list.setAttribute("aria-busy", String(value));
      list.querySelectorAll<HTMLButtonElement>("button").forEach(button => { button.disabled = value || button.dataset.boundary === "true"; });
      list.querySelectorAll<HTMLLIElement>("li").forEach(item => { item.draggable = !value; });
    }
    function showError(cause: unknown) {
      status.textContent = "";
      error.textContent = errorMessage(cause, "商品圖片操作失敗，請稍後再試。");
      error.hidden = false;
    }
    async function run(action: () => Promise<void>) {
      if (busy) return;
      setBusy(true); error.hidden = true;
      try { await action(); } catch (cause) {
        // Report the original failure immediately, even when the follow-up read stalls.
        showError(cause);
        // A response may be lost after a commit; D1 also commits before R2 cleanup.
        // Bound reconciliation while keeping one mutation at a time and preserving
        // unfinished upload identities. Retry still replays the same committed image.
        try {
          const data = await readResult<{ images: ProductImage[] }>(await fetch(list.dataset.endpoint!, { signal: AbortSignal.timeout(3000) }));
          images = data.images; render();
        } catch { /* Keep the last known gallery and the original useful error. */ }
      }
      finally { setBusy(false); }
    }
    async function mutate(method: string, body: unknown) {
      return readResult(await fetch(list.dataset.endpoint!, { method, headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) }));
    }
    function render(focusId?: string, focusAction?: string) {
      list.replaceChildren(...images.map((image, index) => {
        const item = document.createElement("li"); item.dataset.imageId = image.id; item.draggable = !busy;
        const photo = document.createElement("img"); const variant = image.variants[0]!;
        photo.src = `/images/${variant.key}`; photo.width = variant.width; photo.height = variant.height;
        photo.alt = `${list.dataset.productName}的商品圖片 ${index + 1}`;
        const label = document.createElement("span"); label.textContent = index === 0 ? "封面" : `商品圖片 ${index + 1}`;
        const actions = document.createElement("div"); actions.className = "image-actions";
        for (const [action, text, boundary] of [["up", "上移", index === 0], ["down", "下移", index === images.length - 1], ["delete", "刪除", false]] as const) {
          const button = document.createElement("button"); button.type = "button"; button.textContent = text; button.dataset.action = action;
          button.dataset.boundary = String(boundary); button.disabled = busy || boundary;
          button.setAttribute("aria-label", `${text}商品圖片 ${index + 1}`);
          button.addEventListener("click", () => {
            if (action === "delete") {
              if (busy || !confirm(`確定刪除商品圖片 ${index + 1}？`)) return;
              void run(async () => {
                await mutate("DELETE", { imageId: image.id }); images = images.filter(value => value.id !== image.id);
                render(images[Math.min(index, images.length - 1)]?.id, "delete"); status.textContent = "已刪除商品圖片。";
              });
            } else void move(image.id, index + (action === "up" ? -1 : 1), action);
          });
          actions.appendChild(button);
        }
        item.addEventListener("dragstart", event => { if (busy) { event.preventDefault(); return; } draggedId = image.id; event.dataTransfer?.setData("text/plain", image.id); });
        item.addEventListener("dragover", event => { if (!busy && draggedId) { event.preventDefault(); item.classList.add("drag-over"); } });
        item.addEventListener("dragleave", () => item.classList.remove("drag-over"));
        item.addEventListener("drop", event => { event.preventDefault(); item.classList.remove("drag-over"); if (draggedId) void move(draggedId, index, "down"); draggedId = undefined; });
        item.addEventListener("dragend", () => { draggedId = undefined; list.querySelectorAll(".drag-over").forEach(el => el.classList.remove("drag-over")); });
        item.appendChild(photo); item.appendChild(label); item.appendChild(actions); return item;
      }));
      if (!images.length && focusAction) requestAnimationFrame(() => uploadButton.focus());
      if (focusId) requestAnimationFrame(() => {
        const item = Array.from(list.children).find(item => (item as HTMLElement).dataset.imageId === focusId);
        const preferred = item?.querySelector<HTMLButtonElement>(`button[data-action="${focusAction}"]`);
        (preferred && !preferred.disabled ? preferred : item?.querySelector<HTMLButtonElement>("button:not(:disabled)"))?.focus();
      });
    }
    async function move(imageId: string, target: number, focusAction: string) {
      const from = images.findIndex(image => image.id === imageId);
      if (from < 0 || target < 0 || target >= images.length || from === target) return;
      await run(async () => {
        const reordered = [...images]; reordered.splice(target, 0, reordered.splice(from, 1)[0]!);
        await mutate("PUT", { imageIds: reordered.map(image => image.id) });
        images = reordered; render(imageId, focusAction); status.textContent = `已儲存商品圖片順序，第 1 張為封面。`;
      });
    }
    refreshButton.addEventListener("click", () => void run(async () => {
      const data = await readResult<{ images: ProductImage[] }>(await fetch(list.dataset.endpoint!)); images = data.images; render(); status.textContent = "已重新載入商品圖片。";
    }));
    form.addEventListener("submit", event => {
      event.preventDefault();
      void run(async () => {
        if (!pending.length) return;
        while (pending.length) {
          const next = pending[0]!;
          status.textContent = `正在縮放並上傳商品圖片（剩餘 ${pending.length} 張）…`;
          const image = await uploadImage(form.action, next.file, next.uploadId, "商品圖片");
          if (!images.some(value => value.id === image.id)) images.push(image);
          pending.shift(); render();
        }
        input.value = ""; status.textContent = "已上傳商品圖片。可以回商品管理上架。";
      });
    });
    render();
    // SSR controls stay disabled until every event listener and retry state is ready.
    setBusy(false);
  }
</script>
