---
import { env } from "cloudflare:workers";
import { readAccessJwt } from "../../../admin/access-jwt";
import { categoryUpdateFormToInput, parseCategoryId } from "../../../admin/category-form";
import { describeFailure, logFailure, type Failure } from "../../../admin/failure";
import { formToRecord } from "../../../shared/form-values";
import AdminLayout from "../../../layouts/AdminLayout.astro";

export const prerender = false;

// 授權完全由 App Worker 驗 JWT 決定；這裡只轉交 header，收到 unauthorized 就顯示 403
const jwt = readAccessJwt(Astro.request, env, import.meta.env.DEV);
const id = parseCategoryId(Astro.params.id);
let failure: Failure | undefined;
let submitted: Record<string, string> = {};
let unauthorized = false;
let unavailable = false;

if (id !== null && Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  submitted = formToRecord(form);
  try {
    const result = await env.APP.updateCategory(jwt, categoryUpdateFormToInput(form, id));
    if (result.ok) return Astro.redirect("/admin/categories?saved=updated", 303);
    if (result.reason === "unauthorized") unauthorized = true;
    else failure = describeFailure(result, "儲存分類失敗，請稍後再試");
  } catch (cause) {
    logFailure("admin_category_update_failed", cause);
    failure = { message: "儲存分類失敗，請稍後再試", fields: {} };
  }
}

let category: Awaited<ReturnType<typeof env.APP.getCategoryForAdmin>> | null = null;
if (id !== null && !unauthorized) {
  try {
    category = await env.APP.getCategoryForAdmin(jwt, { id });
  } catch (cause) {
    logFailure("admin_category_load_failed", cause);
    unavailable = true;
  }
}
if (unavailable) Astro.response.status = 503;
else if (unauthorized || (category && !category.ok && category.reason === "unauthorized")) Astro.response.status = 403;
else if (!category?.ok) Astro.response.status = 404;
const current = category?.ok ? category.data : undefined;
const values = {
  categoryName: current?.name ?? "",
  categoryDescription: current?.description ?? "",
  ...submitted,
};
const cover = current?.image?.variants[0];
---

<AdminLayout title="修改分類">
  {
    Astro.response.status === 403 ? (
      <p class="error" role="alert">沒有權限：請確認已通過 Cloudflare Access 登入。</p>
    ) : Astro.response.status === 503 ? (
      <p class="error" role="alert">暫時無法載入分類，請稍後再試。</p>
    ) : Astro.response.status === 404 ? (
      <p class="error" role="alert">找不到這個分類。</p>
    ) : (
      <>
        {failure && <p class="error" role="alert">{failure.message}</p>}
        <div class="admin-card-section">
          <h2>基本資訊</h2>
          <form method="post">
            <p>網址代稱：<code>{current?.slug}</code>（建立後不能修改）</p>
          <label>
            分類名稱
            <input name="categoryName" value={values.categoryName} required />
            {failure?.fields.name?.map((m) => <span class="error">{m}</span>)}
          </label>
          <label>
            分類說明（一行）
            <input name="categoryDescription" value={values.categoryDescription} required />
            {failure?.fields.description?.map((m) => <span class="error">{m}</span>)}
          </label>
          <div class="admin-actions">
            <button type="submit" class="button-primary">儲存</button>
            <a href="/admin/categories">取消</a>
          </div>
        </form>
        </div>
        <section aria-labelledby="category-image-heading" class="admin-card-section">
          <h2 id="category-image-heading">分類圖片</h2>
          <p>每個分類最多一張圖片，可以不上傳。上傳新圖片會取代目前的圖片。</p>
          <img id="category-image" src={cover ? `/images/${cover.key}` : undefined} width={cover?.width} height={cover?.height} alt={`${current?.name}的分類圖片`} hidden={!cover} class="category-preview" />
          <p id="category-image-empty" hidden={!!cover}>目前沒有分類圖片。</p>
          <noscript><p>上傳分類圖片需要啟用 JavaScript。</p></noscript>
          <form id="category-image-upload" action={`/admin/categories/${id}/image`}>
            <label>分類圖片（JPEG、PNG 或 WebP，20 MB 以內）<input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required disabled /></label>
            <p>圖片會在瀏覽器縮放成 WebP，不保存原圖。</p>
            <button type="submit" disabled>上傳分類圖片</button>
          </form>
          <p id="image-status" role="status" aria-live="polite"></p>
          <p id="image-error" class="error" role="alert" hidden></p>
        </section>
      </>
    )
  }
</AdminLayout>

<script>
  import { UserFacingError } from "../../../admin/failure";
  import { errorMessage, uploadImage } from "../../../images/client";
  const LABEL = "分類圖片";
  const form = document.querySelector<HTMLFormElement>("#category-image-upload");
  if (form) {
    const input = form.querySelector<HTMLInputElement>('input[type="file"]')!;
    const uploadButton = form.querySelector<HTMLButtonElement>("button")!;
    const photo = document.querySelector<HTMLImageElement>("#category-image")!;
    const empty = document.querySelector<HTMLElement>("#category-image-empty")!;
    const status = document.querySelector<HTMLElement>("#image-status")!;
    const error = document.querySelector<HTMLElement>("#image-error")!;
    // 同一次選檔共用一個上傳識別碼：回應遺失後重試，App 回原圖片而不是再換一次
    let uploadId = crypto.randomUUID();
    input.addEventListener("change", () => { uploadId = crypto.randomUUID(); });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const file = input.files?.[0];
      if (!file) return;
      uploadButton.disabled = input.disabled = true;
      error.hidden = true;
      status.textContent = "正在縮放並上傳分類圖片…";
      try {
        const image = await uploadImage(form.action, file, uploadId, LABEL);
        const variant = image.variants[0]!;
        photo.src = `/images/${variant.key}`;
        photo.width = variant.width;
        photo.height = variant.height;
        photo.hidden = false;
        empty.hidden = true;
        input.value = "";
        uploadId = crypto.randomUUID();
        status.textContent = "已儲存分類圖片。";
      } catch (cause) {
        if (!(cause instanceof UserFacingError)) console.error(cause);
        status.textContent = "";
        error.textContent = errorMessage(cause, `${LABEL}上傳失敗，請稍後再試`);
        error.hidden = false;
      } finally {
        uploadButton.disabled = input.disabled = false;
      }
    });
    // SSR controls stay disabled until the listeners are ready.
    uploadButton.disabled = input.disabled = false;
  }
</script>
