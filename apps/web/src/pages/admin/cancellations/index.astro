---
import { env } from "cloudflare:workers";
import { readAccessJwt } from "../../../admin/access-jwt";
import { cancellationStatusLabel } from "../../../orders/cancellation";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { formatDateTime } from "../../../orders/labels";
import { DELIVERY_TYPE_LABELS } from "@storefront/app/shipping-types";

export const prerender = false;

// 授權完全由 App Worker 驗 JWT 決定；這裡只轉交 header，收到 unauthorized 就顯示 403
const jwt = readAccessJwt(Astro.request, env, import.meta.env.DEV);
const listing = await env.APP.listCancellationsToReview(jwt);
if (!listing.ok) Astro.response.status = 403;
const priceFormat = new Intl.NumberFormat("zh-TW");
---

<AdminLayout title="取消審核">
  {
    !listing.ok ? (
      <p class="error" role="alert">沒有權限：請確認已通過 Cloudflare Access 登入。</p>
    ) : (
      <>
        <p>
          顧客申請取消已付款、尚未交運的數量。申請成立後這些數量即暫停出貨（仍占保留）；到訂單頁核准或拒絕。
          核准後停止履約並釋放保留，退款另循逐筆退款處理，退款失敗不會恢復出貨。
        </p>
        {listing.data.omitted > 0 && <p class="error" role="alert">另有 {listing.data.omitted} 筆待審的申請未列出。</p>}
        {listing.data.cancellations.length === 0 && <p>目前沒有待審的取消申請。</p>}
        {listing.data.cancellations.length > 0 && (
          <div class="table-scroll" tabindex="0" role="region" aria-label="待審的取消申請"><table>
            <thead>
              <tr><th>申請</th><th>訂單</th><th>顧客</th><th>取消明細</th><th>原因</th></tr>
            </thead>
            <tbody>
              {listing.data.cancellations.map((request) => (
                <tr>
                  <td data-label="申請">#{request.id}<br />{cancellationStatusLabel(request.status)}<br />{formatDateTime(request.requestedAt)}</td>
                  <td data-label="訂單"><a href={`/admin/orders/${request.orderId}#cancellations`}>#{request.orderId}（前往審核）</a></td>
                  <td data-label="顧客">{request.customerEmail}</td>
                  <td data-label="取消明細">
                    <ul class="items">
                      {request.items.map((item) => (
                        <li>{item.productName}{item.variantLabel && `（${item.variantLabel}）`} × {item.quantity}・{DELIVERY_TYPE_LABELS[item.deliveryType]}・NT$ {priceFormat.format(item.amountTwd)}</li>
                      ))}
                    </ul>
                  </td>
                  <td data-label="原因">{request.reason || "（未填）"}</td>
                </tr>
              ))}
            </tbody>
          </table></div>
        )}
      </>
    )
  }
</AdminLayout>

<style>
  .items { margin: 0; padding-left: 1.1em; }
</style>
