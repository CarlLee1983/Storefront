---
import { env } from "cloudflare:workers";
import { MAX_QUANTITY } from "../../cart/cart";
import CartToast from "../../components/CartToast.astro";
import ProductGallery from "../../components/ProductGallery.astro";
import ProductList from "../../components/ProductList.astro";
import QuantityStepper from "../../components/QuantityStepper.astro";
import Layout from "../../layouts/Layout.astro";

export const prerender = false;
const id = /^\d+$/.test(Astro.params.id ?? "") ? Number(Astro.params.id) : NaN;
const result = await env.APP.getProduct({ id });
const product = result.ok ? result.data : null;
if (!product) Astro.response.status = 404;
const priceFormat = new Intl.NumberFormat("zh-TW");
---
<Layout title={product?.name ?? "找不到頁面"} noindex={!product} hideTitle={!!product}>
  {product ? <>
    <nav class="breadcrumb" aria-label="麵包屑">
      <ol>
        <li><a href="/products">全部商品</a></li>
        {product.category && <li><a href={`/categories/${product.category.slug}`}>{product.category.name}</a></li>}
        <li><span aria-current="page">{product.name}</span></li>
      </ol>
    </nav>
    <div class="product-detail">
      <ProductGallery name={product.name} images={product.images} />
      <section class="product-information" aria-label="商品資訊">
        {product.category && <p class="eyebrow">{product.category.name}</p>}
        <h1>{product.name}</h1>
        <p class="price">NT$ {priceFormat.format(product.priceTwd)}</p>
        <p class="availability">{product.purchasable ? `現貨，可售 ${product.available} 件` : "已售完"}</p>
        <p class="description">{product.description}</p>
        {product.purchasable && <form class="buy-form" data-product-id={product.id} data-name={product.name} data-price={product.priceTwd} data-cover={JSON.stringify(product.images[0] ?? null)}>
          <label for="buy-quantity">數量</label>
          <QuantityStepper id="buy-quantity" max={MAX_QUANTITY} decreaseLabel="減少數量" increaseLabel="增加數量" />
          <button type="submit" class="buy-button">加入購物車<span aria-hidden="true"> →</span></button>
          <CartToast />
        </form>}
        <p class="policy">含稅、免運。付款後無法自行取消，商品問題請聯繫客服。</p>
      </section>
    </div>
    {product.related.length > 0 && <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">同分類的其他商品</h2>
      <ProductList products={product.related} />
    </section>}
  </> : <><p>這個商品不存在，或已經下架。</p><p><a href="/">回首頁</a></p></>}
</Layout>
<script>
  import { parseCartCover } from "../../cart/cover";
  import { showCartToast } from "../../cart/toast";
  import { addToCart, clampQuantity } from "../../cart/cart";
  import { addFeedback } from "../../cart/feedback";
  import { storageOf } from "../../cart/storage";
  import { updateCart } from "../../cart/store";
  const form = document.querySelector<HTMLFormElement>("form.buy-form");
  if (form) {
    const input = form.querySelector<HTMLInputElement>("input[name=quantity]")!;
    // 加減按鈕只在 1 到上限之間調整；輸入框內容無效（空白、小數）時從 1 起算
    for (const button of form.querySelectorAll<HTMLButtonElement>("[data-step]")) {
      button.addEventListener("click", () => {
        const current = Number.isInteger(input.valueAsNumber) ? input.valueAsNumber : 1;
        input.value = String(clampQuantity(current + Number(button.dataset.step)));
      });
    }
    form.addEventListener("submit", event => {
      event.preventDefault();
      const item = { productId: Number(form.dataset.productId), name: form.dataset.name ?? "", unitPriceTwd: Number(form.dataset.price), cover: parseCartCover(JSON.parse(form.dataset.cover ?? "null")) };
      const quantity = Number(new FormData(form).get("quantity"));
      showCartToast(form.querySelector<HTMLElement>(".cart-status")!, addFeedback(quantity, item.productId, () =>
        updateCart(storageOf(window), window, current => addToCart(current, item, quantity))));
    });
  }
</script>
<style>
  .breadcrumb { margin-bottom: var(--space-4); font-size: var(--text-sm); }
  .breadcrumb ol { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); margin: 0; padding: 0; list-style: none; }
  .breadcrumb li + li::before { content: "/"; margin-right: var(--space-2); color: var(--color-muted); }
  .breadcrumb a, .breadcrumb [aria-current] { color: var(--color-muted); }
  .breadcrumb [aria-current] { text-decoration: none; }
  .product-detail { display: grid; gap: var(--space-6); align-items: start; }
  .product-information { min-width: 0; }
  .eyebrow { margin: 0 0 var(--space-2); font-size: var(--text-sm); letter-spacing: .12em; }
  .product-information h1 { margin: 0 0 var(--space-3); font-size: clamp(2rem, 6vw, 3.5rem); line-height: 1.1; }
  .price { margin: 0 0 var(--space-2); font-size: var(--text-xl); font-weight: 700; }
  .availability { margin: 0 0 var(--space-4); font-size: var(--text-sm); color: var(--color-muted); }
  .description { margin: 0 0 var(--space-6); white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.8; }
  .buy-form { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-3); align-items: end; margin-bottom: var(--space-6); }
  .buy-form label { grid-column: 1 / -1; margin: 0; font-size: var(--text-sm); font-weight: 700; }
  .buy-button { min-height: 48px; font-weight: 700; }
  .policy { margin: 0; font-size: var(--text-sm); color: var(--color-muted); }
  .related { margin-top: var(--space-8); }
  .related h2 { margin: 0 0 var(--space-4); font-size: var(--text-xl); letter-spacing: -.02em; }
  @media (min-width: 56.25rem) {
    .product-detail { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-8); }
    .product-information { position: sticky; top: var(--space-4); }
  }
</style>
