---
import { env } from "cloudflare:workers";
import { MAX_QUANTITY } from "../../cart/cart";
import CartToast from "../../components/CartToast.astro";
import NotFoundContent from "../../components/NotFoundContent.astro";
import ProductGallery from "../../components/ProductGallery.astro";
import ProductList from "../../components/ProductList.astro";
import QuantityStepper from "../../components/QuantityStepper.astro";
import Layout from "../../layouts/Layout.astro";
import { notFoundDescription, previewText } from "../../metadata";
import { saleDisplay } from "../../sale/price";

export const prerender = false;
const id = /^\d+$/.test(Astro.params.id ?? "") ? Number(Astro.params.id) : NaN;
const result = await env.APP.getProduct({ id });
const product = result.ok ? result.data : null;
if (!product) Astro.response.status = 404;
const priceFormat = new Intl.NumberFormat("zh-TW");
const sale = product ? saleDisplay(product.priceTwd, product.compareAtPriceTwd) : null;
---
<Layout title={product?.name ?? "找不到這個頁面"} headTitle={product ? undefined : "找不到頁面｜靜物"} description={product ? previewText(product.description?.split(/\n\s*\n/)[0], `在靜物查看${product.name}的圖片、售價與商品資訊。`) : notFoundDescription} image={product?.images[0]?.variants.at(-1)?.key ? `/images/${product.images[0]!.variants.at(-1)!.key}` : undefined} noindex={!product} hideTitle={!!product}>
  {product ? <>
    <nav class="breadcrumb" aria-label="麵包屑">
      <ol>
        <li><a href="/products">全部商品</a></li>
        {product.category && <li><a href={`/categories/${product.category.slug}`}>{product.category.name}</a></li>}
        <li><span aria-current="page">{product.name}</span></li>
      </ol>
    </nav>
    <div class="product-detail">
      <ProductGallery name={product.name} images={product.images} />
      <section class="product-information" aria-label="商品資訊">
        {product.category && <p class="eyebrow">{product.category.name}</p>}
        <h1>{product.name}</h1>
        <p class:list={["price", { "on-sale": sale }]}>
          <span class="price-now">NT$ {priceFormat.format(product.priceTwd)}</span>
          {sale && <s class="price-was"><span class="visually-hidden">原價 </span>NT$ {priceFormat.format(sale.compareAtTwd)}</s>}
          {sale?.badge && <span class="sale-tag"><span aria-hidden="true">{sale.badge}</span><span class="visually-hidden">省 {sale.percent}%</span></span>}
        </p>
        <p class:list={["availability", { "is-low-stock": product.purchasable && product.available > 0 && product.available <= 5 }]}>
          {product.purchasable ? (product.available <= 5 ? `僅剩 ${product.available} 件現貨` : `現貨，可售 ${product.available} 件`) : "已售完"}
        </p>
        <p class="description">{product.description}</p>
        {product.purchasable && <form class="buy-form" data-product-id={product.id} data-variant-id={product.defaultVariantId} data-name={product.name} data-price={product.priceTwd} data-cover={JSON.stringify(product.images[0] ?? null)}>
          <label for="buy-quantity">數量</label>
          <QuantityStepper id="buy-quantity" max={MAX_QUANTITY} decreaseLabel="減少數量" increaseLabel="增加數量" />
          <button type="submit" class="buy-button">加入購物車<span aria-hidden="true"> →</span></button>
          <CartToast />
        </form>}
        <p class="policy">售價含稅、免運。付款後無法自行取消訂單；商品或訂單問題請寫信至 <a href="mailto:hello@gravito.dev">hello@gravito.dev</a>。詳情請見<a href="/returns">退換貨說明</a>。</p>
      </section>
    </div>
    {product.related.length > 0 && <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">同分類的其他商品</h2>
      <ProductList products={product.related} />
    </section>}
  </> : <NotFoundContent />}
</Layout>
<script>
  import { parseCartCover } from "../../cart/cover";
  import { showCartToast } from "../../cart/toast";
  import { addToCart, clampQuantity } from "../../cart/cart";
  import { addFeedback } from "../../cart/feedback";
  import { storageOf } from "../../cart/storage";
  import { updateCart } from "../../cart/store";
  const form = document.querySelector<HTMLFormElement>("form.buy-form");
  if (form) {
    const input = form.querySelector<HTMLInputElement>("input[name=quantity]")!;
    // 加減按鈕只在 1 到上限之間調整；輸入框內容無效（空白、小數）時從 1 起算
    for (const button of form.querySelectorAll<HTMLButtonElement>("[data-step]")) {
      button.addEventListener("click", () => {
        const current = Number.isInteger(input.valueAsNumber) ? input.valueAsNumber : 1;
        input.value = String(clampQuantity(current + Number(button.dataset.step)));
      });
    }
    const buyBtn = form.querySelector<HTMLButtonElement>(".buy-button");
    form.addEventListener("submit", event => {
      event.preventDefault();
      const item = { variantId: Number(form.dataset.variantId), productId: Number(form.dataset.productId), name: form.dataset.name ?? "", unitPriceTwd: Number(form.dataset.price), cover: parseCartCover(JSON.parse(form.dataset.cover ?? "null")) };
      const quantity = Number(new FormData(form).get("quantity"));
      showCartToast(form.querySelector<HTMLElement>(".cart-status")!, addFeedback(quantity, item.variantId, () =>
        updateCart(storageOf(window), window, current => addToCart(current, item, quantity))));

      if (buyBtn) {
        const originalText = buyBtn.innerHTML;
        buyBtn.innerHTML = '已加入購物車 <span aria-hidden="true">✓</span>';
        buyBtn.classList.add("is-added");
        window.setTimeout(() => {
          buyBtn.innerHTML = originalText;
          buyBtn.classList.remove("is-added");
        }, 1500);
      }
    });
  }
</script>
<style>
  .breadcrumb { margin-bottom: var(--space-6); font-size: var(--text-sm); }
  .breadcrumb ol { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); margin: 0; padding: 0; list-style: none; }
  .breadcrumb li + li::before { content: "/"; margin-right: var(--space-2); color: var(--color-subtle); }
  .breadcrumb a { color: var(--color-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary); text-decoration: underline; }
  .breadcrumb [aria-current] { color: var(--color-text); font-weight: 500; text-decoration: none; }
  .product-detail { display: grid; gap: var(--space-8); align-items: start; }
  .product-information {
    min-width: 0;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-subtle);
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 600;
  }
  .product-information h1 { margin: 0 0 var(--space-3); font-size: var(--text-display-product); line-height: 1.15; letter-spacing: -0.02em; }
  .price { margin: 0 0 var(--space-3); font-size: var(--text-xl); font-weight: 700; }
  .price { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3); }
  .availability {
    display: inline-block;
    margin: 0 0 var(--space-4);
    padding: 0.2rem 0.6rem;
    font-size: 0.8125rem;
    font-weight: 500;
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text);
  }
  .availability.is-low-stock {
    background: var(--color-primary-light);
    border-color: rgba(158, 61, 44, 0.25);
    color: var(--color-primary);
    font-weight: 600;
  }
  .description { margin: 0 0 var(--space-6); white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.8; color: var(--color-text); }
  .buy-form {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: end;
    margin-bottom: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .buy-form label { grid-column: 1 / -1; margin: 0; font-size: var(--text-sm); font-weight: 600; }
  .buy-button {
    min-height: 44px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) var(--ease-spring);
  }
  .buy-button.is-added {
    background: #2b593f;
    box-shadow: 0 4px 14px rgba(43, 89, 63, 0.3);
  }
  .policy {
    margin: 0;
    padding: var(--space-4);
    background: var(--color-panel);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.6;
  }
  .policy a { color: var(--color-text); font-weight: 500; }
  .related { margin-top: var(--section-gap); }
  .related h2 { margin: 0 0 var(--space-4); font-size: var(--text-xl); font-weight: 700; }
  @media (min-width: 56.25rem) {
    .product-detail { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-8); }
    .product-information { position: sticky; top: calc(var(--space-8) + 40px); }
  }
</style>
