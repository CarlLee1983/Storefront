---
import { safeNextPath } from "../auth/customer";
import Layout from "../layouts/Layout.astro";

export const prerender = false;

const next = safeNextPath(Astro.url.searchParams.get("next"));
if (Astro.locals.customer) {
  return Astro.redirect(next, 303);
}
---

<Layout title="登入" noindex>
  <div class="login-card">
    <p class="login-desc">使用 LINE 或 Google 登入。兩種方式是各自獨立的帳號，不會合併；結帳後請用原本的方式登入查看訂單。</p>
    <p id="error" class="error" role="alert" hidden></p>
    <div class="login-actions">
      <button type="button" class="social-button line" data-provider="line" data-next={next}>用 LINE 登入</button>
      <button type="button" class="social-button google" data-provider="google" data-next={next}>用 Google 登入</button>
    </div>
  </div>
  <script>
    import { requestSocialLogin } from "../auth/client";

    // 發起登入：POST 到 Better Auth，拿到 provider 的授權網址後導向；state cookie 由回應的 Set-Cookie 設定。
    // 任何失敗（含網路錯誤與 5xx）都顯示同一則訊息
    for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-provider]")) {
      button.addEventListener("click", async () => {
        const url = await requestSocialLogin(fetch, button.dataset.provider ?? "", button.dataset.next ?? "/");
        if (url) {
          location.href = url;
          return;
        }
        const error = document.querySelector<HTMLElement>("#error")!;
        error.textContent = "目前無法登入，請稍後再試。";
        error.hidden = false;
      });
    }
  </script>
</Layout>

<style>
  .login-card {
    max-width: 28rem;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-subtle);
  }
  .login-desc {
    margin: 0 0 var(--space-6);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .login-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .social-button {
    width: 100%;
    min-height: 48px;
    font-weight: 600;
  }
  .social-button.line {
    background: #06c755;
    border-color: #06c755;
    /* 白字在 LINE 綠上對比只有 2.25，改深色字（實測 7.78:1，hover 6.12:1）以符合 WCAG AA 並保留品牌綠底 */
    color: var(--color-text);
  }
  .social-button.line:hover {
    background: #05b04c;
    border-color: #05b04c;
    box-shadow: 0 4px 12px rgba(6, 199, 85, 0.25);
  }
  .social-button.google {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    box-shadow: 0 1px 2px rgba(28, 27, 26, 0.05);
  }
  .social-button.google:hover {
    background: var(--color-panel);
    border-color: var(--color-control-border);
    box-shadow: 0 4px 12px rgba(28, 27, 26, 0.08);
  }
</style>
