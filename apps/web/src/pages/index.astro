---
import { env } from "cloudflare:workers";
import ProductList from "../components/ProductList.astro";
import Layout from "../layouts/Layout.astro";

export const prerender = false;

// 前台不需登入；只列上架中的商品
const products = await env.APP.listProducts();
---

<Layout title="商品">
  {products.ok && products.data.length === 0 && <p>目前沒有上架的商品。</p>}
  {products.ok && products.data.length > 0 && <ProductList products={products.data} />}
</Layout>
