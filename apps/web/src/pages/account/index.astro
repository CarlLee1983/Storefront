---
import { env } from "cloudflare:workers";
import { loginUrl } from "../../auth/customer";
import { checkoutEntry } from "../../checkout/entry";
import { contactFormToInput, describeContactFailure } from "../../account/contact";
import Layout from "../../layouts/Layout.astro";
import { formatDateTime } from "../../orders/labels";
import { toText } from "../../shared/form-values";

export const prerender = false;

// 帳戶頁只給顧客本人：未登入導去登入，登入後回到這一頁
const entry = checkoutEntry(Astro.locals.customer, Astro.url);
if (entry.kind === "redirect") {
  return Astro.redirect(entry.location, 303);
}

const cookie = Astro.request.headers.get("cookie") ?? "";
let failure: string | undefined;
let submittedEmail = "";

// 送出聯絡 email（POST）：成功後 303 回本頁（避免重新整理重送），失敗留在本頁並保留輸入
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  submittedEmail = toText(form.get("email"));
  const result = await env.APP.requestContactEmail(cookie, contactFormToInput(form));
  if (!result.ok && result.reason === "unauthorized") return Astro.redirect(loginUrl(Astro.url), 303);
  if (result.ok) return Astro.redirect(`/account?sent=${result.data.delivered ? "1" : "failed"}`, 303);
  failure = describeContactFailure(result);
}

const contact = await env.APP.getMyContact(cookie);
if (!contact.ok) return Astro.redirect(loginUrl(Astro.url), 303);
const { verifiedEmail, pending } = contact.data;
const sent = Astro.url.searchParams.get("sent");
const justVerified = Astro.url.searchParams.get("verified") === "1";
const fromCheckout = Astro.url.searchParams.get("reason") === "checkout";
---

<Layout title="帳戶" description="管理登入帳號與聯絡 email，並查看模擬信箱。" noindex>
  {fromCheckout && !verifiedEmail && <p role="status" class="notice">首次結帳前，請先驗證聯絡 email；驗證完成後回到<a href="/checkout">結帳頁</a>，購物車內容會保留。</p>}
  {justVerified && <p role="status" class="notice">聯絡 email 已完成驗證。</p>}
  {sent === "1" && <p role="status" class="notice">驗證信已寄到你的模擬信箱，請到<a href="/account/mailbox">我的信箱</a>開啟驗證連結。</p>}
  {sent === "failed" && <p role="alert" class="error">驗證信投遞失敗，信件尚未進入信箱。請稍後再試，或聯絡客服請我們重送。</p>}

  <section class="panel" aria-labelledby="login-title">
    <h2 id="login-title">登入帳號</h2>
    <p>{Astro.locals.customer?.name}</p>
    <p class="hint">LINE 與 Google 是各自獨立的帳號，不會合併；登入用的 email 也不會當作聯絡 email。</p>
  </section>

  <section class="panel" aria-labelledby="contact-title">
    <h2 id="contact-title">聯絡 email</h2>
    {verifiedEmail
      ? <p>已驗證：<strong class="address">{verifiedEmail}</strong>。訂單通知會寄到這個地址。</p>
      : <p>尚未驗證聯絡 email。首次結帳前須先驗證。</p>}
    {pending && <p>等待驗證：<strong class="address">{pending.email}</strong>（<time datetime={new Date(pending.expiresAt).toISOString()}>{formatDateTime(pending.expiresAt)}</time> 前有效）。請到<a href="/account/mailbox">我的信箱</a>開啟驗證信。{verifiedEmail && "驗證完成前，通知仍寄到已驗證的地址。"}</p>}
    <form method="post" action="/account">
      <label>
        {verifiedEmail ? "更換聯絡 email" : "聯絡 email"}
        <input type="email" name="email" autocomplete="email" inputmode="email" required value={submittedEmail} aria-describedby={failure ? "email-error" : undefined} aria-invalid={failure ? "true" : undefined} />
      </label>
      {failure && <p id="email-error" class="error" role="alert">{failure}</p>}
      <button type="submit">寄出驗證信</button>
    </form>
  </section>

  <p class="links"><a href="/account/mailbox">我的信箱</a><a href="/orders">我的訂單</a></p>
</Layout>

<style>
  .panel { max-width: 36rem; margin-bottom: var(--space-6); padding: var(--space-6); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: var(--shadow-subtle); }
  .panel h2 { margin-top: 0; font-size: var(--text-base); font-weight: 700; }
  .panel input { width: 100%; min-height: 44px; border-radius: var(--radius-sm); border: 1px solid var(--color-border); }
  .panel button { width: 100%; margin-top: var(--space-4); }
  .address { overflow-wrap: anywhere; }
  .hint { color: var(--color-muted); font-size: var(--text-sm); margin-bottom: 0; }
  .notice { max-width: 36rem; }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .links a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (min-width: 40rem) { .panel button { width: auto; min-width: 10rem; } }
</style>
