---
import "../styles/global.css";
import "../styles/admin.css";

interface Props { title: string }
const { title } = Astro.props;
const path = Astro.url.pathname;
const section = path.startsWith("/admin/categories") ? "categories" : path.startsWith("/admin/orders") ? "orders" : "products";
const links = [
  { section: "products", href: "/admin", label: "商品管理" },
  { section: "categories", href: "/admin/categories", label: "分類管理" },
  { section: "orders", href: "/admin/orders", label: "訂單管理" },
];
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}｜Storefront</title>
  </head>
  <body class="admin-shell">
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <header class="site-header">
      <a class="brand" href="/admin">Storefront</a>
      <nav aria-label="後台導覽">
        {links.map(link => <a href={link.href} aria-current={link.section === section ? "page" : undefined}>{link.label}</a>)}
        <a href="/">前往前台</a>
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>
