---
import "../styles/global.css";
import "../styles/admin.css";
import AdminNavigation from "../components/AdminNavigation.astro";
import { readAdminListReturn } from "../admin/list-return";

interface Props { title: string; listReturn?: string }
const { title, listReturn } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "");
const groups = [
  { label: "商品與庫存", links: [
    { href: "/admin/products", label: "商品管理" },
    { href: "/admin/categories", label: "分類管理" },
    { href: "/admin/stock-movements", label: "庫存流水" },
    { href: "/admin/low-stock", label: "低庫存提醒" },
  ] },
  { label: "訂單與售後", links: [
    { href: "/admin/orders", label: "訂單管理" },
    { href: "/admin/cancellations", label: "取消審核" },
    { href: "/admin/returns", label: "退貨處理" },
  ] },
  { label: "款項與憑證", links: [
    { href: "/admin/payments", label: "付款補查" },
    { href: "/admin/refunds", label: "退款待辦" },
    { href: "/admin/invoices", label: "發票待辦" },
  ] },
  { label: "設定與通知", links: [
    { href: "/admin/shipping", label: "運費設定" },
    { href: "/admin/mail", label: "信件投遞" },
  ] },
];
const current = groups.flatMap(group => group.links).find(link =>
  path === link.href || path.startsWith(`${link.href}/`)
);
const showBreadcrumb = current && /^\/admin\/(products|categories|orders)\/[^/]+$/.test(path);
const breadcrumbHref = current?.href === "/admin/products"
  ? readAdminListReturn(listReturn ?? null, "products")
  : current?.href === "/admin/orders"
    ? readAdminListReturn(listReturn ?? null, "orders")
    : current?.href;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}｜Storefront</title>
  </head>
  <body class="admin-shell">
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <header class="site-header admin-header">
      <div class="admin-brand-group">
        <a class="brand" href="/admin">
          <span class="brand-badge">管理後台</span>
          Still Life
        </a>
      </div>
      <div class="admin-header-actions">
        <button type="button" class="admin-menu-button" id="admin-menu-open" aria-label="開啟後台選單" aria-haspopup="dialog" aria-controls="admin-menu" aria-expanded="false">
          選單
        </button>
        <a href="/" class="admin-storefront-link" target="_blank" rel="noopener noreferrer">
          <span>前往前台</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>
    </header>
    <aside class="admin-sidebar">
      <AdminNavigation groups={groups} currentHref={current?.href} idPrefix="desktop" />
    </aside>
    <dialog class="admin-menu" id="admin-menu" aria-labelledby="admin-menu-title">
      <div class="admin-menu-header">
        <p id="admin-menu-title">後台選單</p>
        <button type="button" id="admin-menu-close" aria-label="關閉後台選單" autofocus>關閉</button>
      </div>
      <AdminNavigation groups={groups} currentHref={current?.href} idPrefix="mobile" />
    </dialog>
    <main id="main-content" tabindex="-1">
      {showBreadcrumb && (
        <nav aria-label="麵包屑" class="admin-breadcrumb">
          <ol>
            <li><a href={breadcrumbHref}>{current.label}</a></li>
            <li><span aria-hidden="true">/</span><span aria-current="page">{title}</span></li>
          </ol>
        </nav>
      )}
      <div class="admin-page-header">
        <h1>{title}</h1>
      </div>
      <slot />
    </main>
  </body>
</html>

<script>
  const openButton = document.querySelector<HTMLButtonElement>("#admin-menu-open")!;
  const menu = document.querySelector<HTMLDialogElement>("#admin-menu")!;
  const desktop = window.matchMedia("(min-width: 64rem)");

  openButton.addEventListener("click", () => {
    menu.showModal();
    openButton.setAttribute("aria-expanded", "true");
  });
  document.querySelector("#admin-menu-close")!.addEventListener("click", () => menu.close());
  menu.addEventListener("close", () => {
    openButton.setAttribute("aria-expanded", "false");
    if (!desktop.matches) openButton.focus();
  });
  menu.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) menu.close();
  });
  // 旋轉裝置或放大視窗後解除原生 modal，避免桌機內容仍被設為 inert。
  desktop.addEventListener("change", () => {
    if (desktop.matches && menu.open) {
      menu.close();
      const link = document.querySelector<HTMLAnchorElement>(".admin-sidebar a[aria-current='page']")
        ?? document.querySelector<HTMLAnchorElement>(".admin-sidebar a");
      link?.focus();
    }
  });
</script>
