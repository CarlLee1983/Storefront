---
import "../styles/global.css";
import { LOGIN_PATH, loginUrl } from "../auth/customer";

interface Props {
  title: string;
  admin?: boolean;
  noindex?: boolean;
}
const { title, admin = false, noindex = false } = Astro.props;
// 管理後台由 Cloudflare Access 保護，與顧客登入無關，不顯示登入狀態
const customer = admin ? null : Astro.locals.customer;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {(admin || noindex) && <meta name="robots" content="noindex" />}
    <title>{title}｜Storefront</title>

  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <header class="site-header">
    <nav aria-label={admin ? "後台導覽" : "主要導覽"}>
      <a href="/">Storefront</a>
      {admin && <a href="/admin">管理後台</a>}
      {admin && <a href="/admin/orders">訂單管理</a>}
      {
        !admin && (
          <a href="/cart">
            購物車（<span id="cart-count">0</span>）
          </a>
        )
      }
      {
        !admin &&
          (customer ? (
            <>
              <a href="/orders">我的訂單</a>
              <span class="customer-name">{customer.name}</span>
              <button type="button" id="sign-out">登出</button>
            </>
          ) : Astro.url.pathname === LOGIN_PATH ? null : (
            <a href={loginUrl(Astro.url)}>登入</a>
          ))
      }
    </nav>
    </header>
    <p id="sign-out-error" class="error" role="alert" hidden></p>
    <main id="main-content" tabindex="-1">
      <h1>{title}</h1>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Storefront</p>
      <nav aria-label="頁尾導覽">
        <a href="/about">關於</a>
        <a href="/faq">常見問題</a>
        <a href="/returns">退換貨說明</a>
      </nav>
    </footer>
    <script>
      import { requestSignOut } from "../auth/client";
      import { cartCount } from "../cart/cart";
      import { loadCart, storageOf } from "../cart/storage";
      import { CART_CHANGED_EVENT } from "../cart/store";

      // 購物車件數：載入時、本頁改動時、其他分頁改動時（storage 事件）都重讀 localStorage
      const cartCountEl = document.querySelector<HTMLElement>("#cart-count");
      const showCartCount = () => {
        if (!cartCountEl) return;
        const count = String(cartCount(loadCart(storageOf(window))));
        if (cartCountEl.textContent !== count) {
          cartCountEl.textContent = count;
          cartCountEl.classList.remove("count-bump");
          if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            void cartCountEl.offsetWidth;
            cartCountEl.classList.add("count-bump");
          }
        }
      };
      showCartCount();
      window.addEventListener(CART_CHANGED_EVENT, showCartCount);
      window.addEventListener("storage", showCartCount);

      // 登出：Better Auth 的 sign-out 是 POST（需帶 Origin 與 cookie），回應會清掉 session cookie
      const signOut = document.querySelector<HTMLButtonElement>("#sign-out");
      signOut?.addEventListener("click", async () => {
        // 請求進行中停用按鈕，避免連點重複送出；失敗才恢復
        signOut.disabled = true;
        if (await requestSignOut(fetch)) {
          location.reload();
          return;
        }
        signOut.disabled = false;
        const error = document.querySelector<HTMLElement>("#sign-out-error")!;
        error.textContent = "登出失敗，請稍後再試。";
        error.hidden = false;
      });
    </script>
  </body>
</html>

<style>
  #cart-count { display: inline-block; min-width: 1ch; text-align: center; font-weight: 700; }
  .count-bump { animation: count-bump var(--duration-normal) ease-out; }
  @keyframes count-bump { 50% { transform: translateY(-.25rem) scale(1.2); } }
  @media (prefers-reduced-motion: reduce) { .count-bump { animation: none; } }
</style>
