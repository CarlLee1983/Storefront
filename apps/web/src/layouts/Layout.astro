---
interface Props {
  title: string;
  admin?: boolean;
}
const { title, admin = false } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {admin && <meta name="robots" content="noindex" />}
    <title>{title}｜Storefront</title>
    <style>
      body { font-family: system-ui, sans-serif; margin: 0 auto; max-width: 48rem; padding: 1rem; line-height: 1.6; }
      table { border-collapse: collapse; width: 100%; }
      th, td { border-bottom: 1px solid #ddd; padding: 0.4rem; text-align: left; }
      label { display: block; margin-block: 0.75rem; }
      input, textarea { display: block; font: inherit; width: 100%; box-sizing: border-box; }
      .error { color: #b00020; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Storefront</a>
      {admin && <a href="/admin">管理後台</a>}
    </nav>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>
