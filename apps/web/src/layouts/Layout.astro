---
import "../styles/global.css";
import { env } from "cloudflare:workers";
import AccountLinks from "../components/AccountLinks.astro";
import CategoryLinks from "../components/CategoryLinks.astro";
import SearchDialog from "../components/SearchDialog.astro";
import SearchForm from "../components/SearchForm.astro";
import { categorySlugFromPath, loadNavCategories } from "../categories/nav";

interface Props {
  title: string;
  admin?: boolean;
  noindex?: boolean;
  /** 頁面自己在版面中放置 h1（`title` 仍用於 <title>）。 */
  hideTitle?: boolean;
}
const { title, admin = false, noindex = false, hideTitle = false } = Astro.props;
// 管理後台由 Cloudflare Access 保護，與顧客登入無關，不顯示登入狀態
const customer = admin ? null : Astro.locals.customer;
// 後台頁不查分類；顧客頁的分類 RPC 失敗時當作沒有分類
const categories = admin ? [] : await loadNavCategories(env.APP);
const currentCategory = categorySlugFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {(admin || noindex) && <meta name="robots" content="noindex" />}
    <title>{title}｜Storefront</title>

  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <header class="site-header">
      <a class="brand" href="/">Storefront</a>
      {
        admin ? (
          <nav aria-label="後台導覽">
            <a href="/admin">管理後台</a>
            <a href="/admin/categories">分類管理</a>
            <a href="/admin/orders">訂單管理</a>
          </nav>
        ) : (
          <>
            <nav class="desktop-only" aria-label="主要導覽">
              <a href="/products" aria-current={Astro.url.pathname === "/products" ? "page" : undefined}>全部商品</a>
              <CategoryLinks categories={categories} current={currentCategory} />
            </nav>
            <div class="tools">
              <div class="desktop-only">
                <SearchDialog />
              </div>
              <div class="desktop-only account">
                <AccountLinks customer={customer} url={Astro.url} />
              </div>
              <a href="/cart">
                購物車（<span id="cart-count">0</span>）
              </a>
              <button type="button" class="icon-button menu-button" id="menu-button" aria-label="開啟選單" aria-haspopup="dialog">
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="2" fill="none" /></svg>
              </button>
            </div>
          </>
        )
      }
    </header>
    {
      !admin && (
        <dialog id="menu-drawer" class="menu-drawer" aria-label="選單">
          <div class="drawer-head">
            <span class="brand">Storefront</span>
            <button type="button" class="icon-button" id="menu-close" aria-label="關閉選單" autofocus>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" fill="none" /></svg>
            </button>
          </div>
          <div class="drawer-search">
            <SearchForm id="drawer-search-q" label="選單搜尋" />
          </div>
          <nav class="drawer-nav" aria-label="行動版導覽">
            <a href="/products" aria-current={Astro.url.pathname === "/products" ? "page" : undefined}>全部商品</a>
            <CategoryLinks categories={categories} current={currentCategory} showDescription />
          </nav>
          <div class="drawer-foot">
            <AccountLinks customer={customer} url={Astro.url} />
          </div>
        </dialog>
      )
    }
    <p id="sign-out-error" class="error" role="alert" hidden></p>
    <main id="main-content" tabindex="-1">
      {!hideTitle && <h1>{title}</h1>}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <p class="brand">Storefront</p>
        <p>為日常挑選的家具與器物。</p>
        <nav aria-label="頁尾導覽">
          <a href="/about">關於</a>
          <a href="/faq">常見問題</a>
          <a href="/returns">退換貨說明</a>
        </nav>
      </div>
    </footer>
    <script>
      import { requestSignOut } from "../auth/client";
      import { cartCount } from "../cart/cart";
      import { loadCart, storageOf } from "../cart/storage";
      import { CART_CHANGED_EVENT } from "../cart/store";

      // 購物車件數：載入時、本頁改動時、其他分頁改動時（storage 事件）都重讀 localStorage
      const cartCountEl = document.querySelector<HTMLElement>("#cart-count");
      const showCartCount = () => {
        if (!cartCountEl) return;
        const count = String(cartCount(loadCart(storageOf(window))));
        if (cartCountEl.textContent !== count) {
          cartCountEl.textContent = count;
          cartCountEl.classList.remove("count-bump");
          if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            void cartCountEl.offsetWidth;
            cartCountEl.classList.add("count-bump");
          }
        }
      };
      showCartCount();
      window.addEventListener(CART_CHANGED_EVENT, showCartCount);
      window.addEventListener("storage", showCartCount);

      // 選單抽屜：原生 dialog 的 showModal() 負責焦點陷阱與 Esc；關閉後明確把焦點還給選單按鈕
      const menuButton = document.querySelector<HTMLButtonElement>("#menu-button");
      const menuDrawer = document.querySelector<HTMLDialogElement>("#menu-drawer");
      menuButton?.addEventListener("click", () => menuDrawer?.showModal());
      document.querySelector("#menu-close")?.addEventListener("click", () => menuDrawer?.close());
      menuDrawer?.addEventListener("close", () => menuButton?.focus());

      // 登出：Better Auth 的 sign-out 是 POST（需帶 Origin 與 cookie），回應會清掉 session cookie
      // 桌機 header 與手機抽屜各有一顆登出按鈕，行為一致
      const signOutButtons = document.querySelectorAll<HTMLButtonElement>("[data-sign-out]");
      for (const signOut of signOutButtons) {
        signOut.addEventListener("click", async () => {
          // 請求進行中停用按鈕，避免連點重複送出；失敗才恢復
          for (const button of signOutButtons) button.disabled = true;
          if (await requestSignOut(fetch)) {
            location.reload();
            return;
          }
          for (const button of signOutButtons) button.disabled = false;
          const error = document.querySelector<HTMLElement>("#sign-out-error")!;
          error.textContent = "登出失敗，請稍後再試。";
          error.hidden = false;
        });
      }
    </script>
  </body>
</html>

<style>
  #cart-count { display: inline-block; min-width: 1ch; text-align: center; font-weight: 700; font-variant-numeric: tabular-nums; }
  .drawer-search { padding: var(--space-4); border-bottom: 1px solid var(--color-border); }
  .count-bump { animation: count-bump var(--duration-normal) ease-out; }
  @keyframes count-bump { 50% { transform: translateY(-.25rem) scale(1.2); } }
  @media (prefers-reduced-motion: reduce) { .count-bump { animation: none; } }
</style>
