<!-- Kept in the form's semantic context so each add action has its own status. -->
<span class="cart-status" role="status" aria-live="polite" aria-atomic="true"></span>

<style>
  .cart-status:not(:empty) {
    position: fixed;
    inset: auto var(--space-4) var(--space-6);
    z-index: 50;
    width: fit-content;
    max-width: calc(100vw - 2 * var(--space-4));
    margin-inline: auto;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-on-inverse);
    background: var(--color-inverse);
    font-size: var(--text-sm);
    font-weight: 500;
    box-shadow: 0 8px 24px rgba(28, 27, 26, 0.25);
    animation: toast-enter var(--duration-normal) var(--ease-spring);
  }
  @keyframes toast-enter {
    from { transform: translateY(1rem) scale(0.95); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .cart-status:not(:empty) { animation: none; } }
</style>
