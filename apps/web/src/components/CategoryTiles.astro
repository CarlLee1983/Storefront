---
import type { ProductImage } from "@storefront/app/product-images";

// 首頁的分類方塊：名稱、說明、分類圖片（沒有圖片時是樣式化的佔位區塊）與箭頭，整塊連到分類頁。
interface Props {
  categories: Array<{ slug: string; name: string; description: string; image: ProductImage | null }>;
}
const { categories } = Astro.props;
---

<ul class="category-tiles">
  {categories.map((category) => (
    <li>
      <a class="tile" href={`/categories/${category.slug}`}>
        <div class="tile-media">
          {category.image
            ? <img
                src={`/images/${category.image.variants[0]!.key}`}
                srcset={category.image.variants.map((v) => `/images/${v.key} ${v.width}w`).join(", ")}
                sizes="(min-width: 56.25rem) 18rem, 50vw"
                width={category.image.variants.at(-1)!.width}
                height={category.image.variants.at(-1)!.height}
                alt=""
                loading="lazy"
              />
            : <span class="tile-placeholder" aria-hidden="true">{[...category.name][0]}</span>}
        </div>
        <div class="tile-body">
          <div class="tile-text">
            <h3>{category.name}</h3>
            <span class="tile-description">{category.description}</span>
          </div>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  /* 柔和溫潤的卡片網格 */
  .category-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  @media (min-width: 56.25rem) {
    .category-tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  .category-tiles li { min-width: 0; }
  .tile {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    transition: transform var(--duration-normal) var(--ease-spring), box-shadow var(--duration-normal) var(--ease-smooth), border-color var(--duration-fast);
  }
  .tile:hover {
    color: var(--color-text);
    border-color: var(--color-control-border);
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }
  .tile:focus-visible { z-index: 1; }
  .tile-media { display: block; aspect-ratio: 4 / 3; background: var(--color-panel); overflow: hidden; }
  .tile-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-normal) var(--ease-smooth);
  }
  .tile:hover .tile-media img {
    transform: scale(1.03);
  }
  .tile-placeholder { display: grid; place-items: center; width: 100%; height: 100%; font-size: var(--text-display-placeholder); font-weight: 700; color: var(--color-subtle); }
  .tile-body { flex: 1; display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2); padding: var(--space-4); }
  .tile-text { min-width: 0; }
  .tile h3 { margin: 0; font-size: var(--text-base); font-weight: 700; line-height: 1.4; }
  .tile-description { display: block; margin-top: var(--space-1); font-size: var(--text-sm); line-height: 1.5; color: var(--color-muted); }
  .tile svg { flex: none; margin-top: var(--space-1); color: var(--color-muted); transition: transform var(--duration-fast) var(--ease-spring), color var(--duration-fast); }
  .tile:hover svg { transform: translateX(0.25rem); color: var(--color-primary); }
  .tile:hover h3 { color: var(--color-primary); }
</style>
