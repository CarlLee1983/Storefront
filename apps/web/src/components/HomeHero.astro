---
import { HERO_SLIDES, imageSrc, imageSrcset } from "../home/content";
import type { NavCategory } from "../categories/nav";

// 主視覺輪播（WAI-ARIA carousel 模式）。沒有 JS 時是一條可捲動的橫向軌道，顯示第一張；
// 控制列（上一張、下一張、暫停、張數）由腳本啟用後才出現；沒有 JS 時軌道本身可聚焦，用方向鍵捲動，
// 啟用後改由按鈕切換，軌道就不再是 tab stop。
const count = HERO_SLIDES.length;
const availableCategoryHrefs = new Set(Astro.props.categories.map((category) => `/categories/${category.slug}`));

interface Props {
  categories: Pick<NavCategory, "slug">[];
}
---

<section class="hero" id="hero" aria-roledescription="carousel" aria-label="主視覺">
  <div class="hero-track" id="hero-track" role="group" aria-label="主視覺投影片" tabindex="0">
    {HERO_SLIDES.map((slide, index) => (
      <div class="hero-slide" role="group" aria-roledescription="slide" aria-label={`第 ${index + 1} 張，共 ${count} 張`}>
        <div class="hero-copy">
          <h2>{slide.title}</h2>
          <p>{slide.description}</p>
          <a class="button-link" href={availableCategoryHrefs.has(slide.href) ? slide.href : "/products"}>
            {availableCategoryHrefs.has(slide.href) ? slide.linkText : "全部商品"}
          </a>
        </div>
        <div class="hero-media">
          <img
            src={imageSrc(slide.image)}
            srcset={imageSrcset(slide.image)}
            sizes="(min-width: 72rem) 42rem, (min-width: 56.25rem) 56vw, 100vw"
            width={slide.image.width}
            height={slide.image.height}
            alt={slide.image.alt}
            style={`object-position: ${slide.focalPosition}`}
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : undefined}
          />
        </div>
      </div>
    ))}
  </div>
  <div class="hero-controls" id="hero-controls" hidden>
    <div class="hero-pagination">
      <span class="hero-page-current" id="hero-current-num">01</span>
      <div class="hero-indicators" id="hero-indicators" role="tablist" aria-label="投影片指示器">
        {HERO_SLIDES.map((_, i) => (
          <button
            type="button"
            role="tab"
            class:list={["hero-dot", { "is-active": i === 0 }]}
            data-slide-index={i}
            aria-label={`切換至第 ${i + 1} 張`}
            aria-selected={i === 0 ? "true" : "false"}
          />
        ))}
      </div>
      <span class="hero-page-total">0{count}</span>
    </div>
    <div class="hero-nav-actions">
      <button type="button" class="hero-nav-btn" id="hero-prev" aria-label="上一張">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <path d="M19 12H5M11 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button type="button" class="hero-nav-btn" id="hero-next" aria-label="下一張">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <div class="hero-nav-divider" aria-hidden="true"></div>
      <button type="button" class="hero-nav-btn hero-toggle" id="hero-toggle" aria-label="暫停自動輪播">
        <span class="toggle-icon-pause" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
            <rect x="6" y="5" width="3.5" height="14" rx="1" />
            <rect x="14.5" y="5" width="3.5" height="14" rx="1" />
          </svg>
        </span>
        <span class="toggle-icon-play" aria-hidden="true" hidden>
          <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
            <polygon points="7 5 19 12 7 19" />
          </svg>
        </span>
      </button>
    </div>
    <p class="hero-status visually-hidden" id="hero-status" aria-live="off" data-count={count}>1 / {count}</p>
  </div>
</section>

<script>
  import { HERO_INTERVAL_MS, indexFromScroll, stepIndex } from "../home/carousel";

  const root = document.querySelector<HTMLElement>("#hero");
  if (root) initCarousel(root);

  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("#hero-track")!;
    const controls = root.querySelector<HTMLElement>("#hero-controls")!;
    const toggle = root.querySelector<HTMLButtonElement>("#hero-toggle")!;
    const status = root.querySelector<HTMLElement>("#hero-status")!;
    const count = track.children.length;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    let index = 0;
    let userPaused = false;
    let hovering = false;
    let focusWithin = false;
    let timer: number | undefined;
    let settle: number | undefined;

    const slides = [...track.children] as HTMLElement[];
    let navigation = 0;

    root.classList.add("is-enhanced");
    controls.hidden = false;
    track.removeAttribute("tabindex");

    // 提前載入並解碼某一張的圖片，切過去時才不會先看到空白
    const warm = (slideIndex: number) => {
      const image = slides[slideIndex]?.querySelector("img");
      if (!image) return Promise.resolve();
      image.loading = "eager";
      return image.decode().catch(() => undefined);
    };

    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>(".hero-dot"));
    const currentNum = root.querySelector<HTMLElement>("#hero-current-num");
    const pauseIcon = toggle.querySelector<HTMLElement>(".toggle-icon-pause");
    const playIcon = toggle.querySelector<HTMLElement>(".toggle-icon-play");

    // 只有目前這張可以聚焦與被讀到；其餘投影片的連結不會被 Tab 到，同時同步指示點狀態
    const showIndex = (next: number) => {
      index = next;
      status.textContent = `${index + 1} / ${count}`;
      if (currentNum) {
        currentNum.textContent = `0${index + 1}`;
      }
      slides.forEach((slide, slideIndex) => { slide.inert = slideIndex !== index; });
      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === index;
        dot.classList.toggle("is-active", isActive);
        dot.setAttribute("aria-selected", String(isActive));
      });
    };

    const goTo = async (next: number) => {
      const ticket = ++navigation;
      showIndex(next);
      sync();
      // 圖片最多等 1.5 秒，網路太慢時寧可先切過去
      await Promise.race([warm(next), new Promise((resolve) => window.setTimeout(resolve, 1500))]);
      if (ticket !== navigation) return;
      track.scrollTo({ left: next * track.clientWidth, behavior: reduced.matches ? "auto" : "smooth" });
    };

    // 自動輪播只在：沒被使用者暫停、滑鼠與焦點都不在輪播內、沒有要求減少動態效果、分頁可見時進行
    function sync() {
      window.clearInterval(timer);
      timer = undefined;
      const playing = !userPaused && !hovering && !focusWithin && !reduced.matches && !document.hidden;
      if (playing) timer = window.setInterval(() => goTo(stepIndex(index, 1, count)), HERO_INTERVAL_MS);
      // 自動輪播中不朗讀張數變化；暫停或手動操作時才朗讀
      status.setAttribute("aria-live", playing ? "off" : "polite");
      toggle.hidden = reduced.matches;
      if (pauseIcon && playIcon) {
        pauseIcon.hidden = userPaused;
        playIcon.hidden = !userPaused;
      }
      toggle.setAttribute("aria-label", userPaused ? "播放自動輪播" : "暫停自動輪播");
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const target = Number(dot.dataset.slideIndex);
        if (!Number.isNaN(target)) goTo(target);
      });
    });

    root.querySelector("#hero-prev")!.addEventListener("click", () => goTo(stepIndex(index, -1, count)));
    root.querySelector("#hero-next")!.addEventListener("click", () => goTo(stepIndex(index, 1, count)));
    toggle.addEventListener("click", () => {
      userPaused = !userPaused;
      sync();
    });

    // 使用者以捲動或觸控滑動換張時，等捲動停下來再更新張數，避免平滑捲動途中閃過中間幾張
    track.addEventListener("scroll", () => {
      window.clearTimeout(settle);
      settle = window.setTimeout(() => showIndex(indexFromScroll(track.scrollLeft, track.clientWidth, count)), 120);
    });

    root.addEventListener("mouseenter", () => { hovering = true; sync(); });
    root.addEventListener("mouseleave", () => { hovering = false; sync(); });
    root.addEventListener("focusin", () => { focusWithin = true; sync(); });
    root.addEventListener("focusout", (event) => {
      if (event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) return;
      focusWithin = false;
      sync();
    });
    document.addEventListener("visibilitychange", sync);
    reduced.addEventListener("change", sync);
    // 視窗寬度改變時，軌道要停在同一張
    window.addEventListener("resize", () => track.scrollTo({ left: index * track.clientWidth, behavior: "auto" }));

    showIndex(0);
    sync();
  }
</script>

<style>
  .hero {
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .hero-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; }
  .is-enhanced .hero-track { scrollbar-width: none; }
  .is-enhanced .hero-track::-webkit-scrollbar { display: none; }
  .hero-slide { flex: 0 0 100%; min-width: 0; display: grid; scroll-snap-align: start; }
  /* 手機上下堆疊：圖在上、文案在下；桌機文字在左、圖在右（示範圖的主體都偏右，左側是留白的牆面） */
  .hero-media { order: -1; aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-panel); }
  .hero-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: var(--space-4); padding: var(--space-6) var(--space-6) var(--space-8); }
  .hero-copy h2 { margin: 0; font-size: var(--text-display-hero); font-weight: 700; line-height: 1.15; text-wrap: balance; letter-spacing: -0.02em; }
  .hero-copy p { margin: 0; font-size: var(--text-base); color: var(--color-muted); max-width: 28em; line-height: 1.6; }
  .button-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-height);
    padding: var(--space-2) var(--space-6);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-on-inverse);
    background: var(--color-primary);
    border-radius: var(--radius-sm);
    box-shadow: 0 1px 3px rgba(158, 61, 44, 0.2);
    transition: all var(--duration-fast) var(--ease-spring);
  }
  .button-link:hover {
    color: var(--color-on-inverse);
    background: var(--color-primary-hover);
    box-shadow: 0 4px 14px rgba(158, 61, 44, 0.3);
    transform: translateY(-1px);
  }
  .button-link:active {
    transform: translateY(0);
  }
  .hero-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .hero-controls[hidden] { display: none; }

  .hero-pagination {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .hero-page-current {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }
  .hero-page-total {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }

  .hero-indicators {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .hero-dot {
    width: 20px;
    height: 2px;
    min-height: 2px;
    padding: 0;
    border: none;
    border-radius: 1px;
    background: var(--color-border);
    cursor: pointer;
    box-shadow: none;
    transition: all var(--duration-fast) var(--ease-spring);
  }
  .hero-dot:hover {
    background: var(--color-subtle);
  }
  .hero-dot.is-active {
    width: 36px;
    background: var(--color-primary);
  }

  .hero-nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    background: var(--color-panel);
    padding: 2px 4px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }
  .hero-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    min-width: 30px;
    height: 30px;
    min-height: 30px;
    padding: 0;
    color: var(--color-muted);
    background: transparent;
    border: none;
    border-radius: var(--radius-xs);
    box-shadow: none;
    cursor: pointer;
    transition: all var(--duration-fast) ease;
  }
  .hero-nav-btn:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }
  .hero-nav-btn:active {
    transform: scale(0.92);
  }
  .hero-nav-divider {
    width: 1px;
    height: 14px;
    background: var(--color-border);
    margin: 0 2px;
  }
  .hero-toggle span {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 56.25rem) {
    .hero-slide { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
    .hero-media { order: 0; }
    .hero-copy { padding: var(--space-8) var(--space-12); }
    .hero-controls { padding: var(--space-4) var(--space-12); }
  }
</style>
