---
import type { ProductImage } from "../../../app/src/product-images";
interface Props { name: string; images: ProductImage[]; /** 首屏顯示第幾張（0 起算）；超出範圍時為第一張。 */ initialIndex?: number }
const { name, images } = Astro.props;
const initialIndex = Number.isInteger(Astro.props.initialIndex) && Astro.props.initialIndex! >= 0 && Astro.props.initialIndex! < images.length ? Astro.props.initialIndex! : 0;
---
<section class="gallery" aria-label={`${name}的商品圖片`} data-initial-index={initialIndex}>
  <p id="gallery-help" class="visually-hidden">可左右滑動，或使用方向鍵切換商品圖片。</p>
  <div class="gallery-track" tabindex="0" role="group" aria-label="商品圖片瀏覽" aria-describedby="gallery-help">
    {images.map((image, index) => (
      <div class="gallery-slide" data-initial={index === initialIndex ? "" : undefined} role="group" aria-label={`第 ${index + 1} 張，共 ${images.length} 張`}>
        <img src={`/images/${image.variants[0]!.key}`}
          srcset={image.variants.map(v => `/images/${v.key} ${v.width}w`).join(", ")}
          sizes="(min-width: 64rem) 38rem, (min-width: 40rem) calc(100vw - 4rem), calc(100vw - 2rem)"
          width={image.variants.at(-1)!.width} height={image.variants.at(-1)!.height}
          alt={`${name}，第 ${index + 1} 張商品圖片`} loading={index === initialIndex ? "eager" : "lazy"} decoding="async" />
      </div>
    ))}
  </div>
  {images.length > 1 && <>
    <div class="gallery-controls">
      <button type="button" class="button-secondary" data-gallery-step="-1" aria-label="上一張商品圖片">←</button>
      <span class="gallery-position" aria-live="polite" aria-atomic="true">{initialIndex + 1} / {images.length}</span>
      <button type="button" class="button-secondary" data-gallery-step="1" aria-label="下一張商品圖片">→</button>
    </div>
    <div class="gallery-thumbnails" role="group" aria-label="選擇商品圖片">
      {images.map((image, index) => (
        <button type="button" data-gallery-index={index} aria-label={`查看${name}第 ${index + 1} 張商品圖片`} aria-current={index === initialIndex ? "true" : undefined}>
          <img src={`/images/${image.variants[0]!.key}`} width={image.variants[0]!.width} height={image.variants[0]!.height} alt="" loading="lazy" />
        </button>
      ))}
    </div>
  </>}
</section>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>(".gallery")) {
    const track = gallery.querySelector<HTMLElement>(".gallery-track")!;
    const slides = [...gallery.querySelectorAll<HTMLElement>(".gallery-slide")];
    const thumbnails = [...gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-index]")];
    const position = gallery.querySelector<HTMLElement>(".gallery-position");
    let selected = 0;
    const initialIndex = Number(gallery.dataset.initialIndex ?? 0);
    const select = (index: number) => {
      if (!Number.isInteger(index) || index < 0 || index >= slides.length) return;
      selected = index;
      thumbnails.forEach((button, i) => {
        if (i === index) button.setAttribute("aria-current", "true");
        else button.removeAttribute("aria-current");
      });
      if (position) position.textContent = `${index + 1} / ${slides.length}`;
    };
    const navigate = (index: number, focus = false) => {
      const next = (index + slides.length) % slides.length;
      select(next);
      // Scroll only the gallery, never the document or the user's focused control.
      track.scrollTo({ left: next * track.clientWidth, behavior: "instant" });
      if (focus) thumbnails[next]?.focus();
    };
    thumbnails.forEach((button, index) => button.addEventListener("click", () => navigate(index)));
    // 選取指定了圖片的商品變體時，由商品頁要求圖庫顯示該張（只在有此圖時動作）
    gallery.addEventListener("gallery:select", event => {
      const index = (event as CustomEvent<{ index: number }>).detail.index;
      if (Number.isInteger(index) && index >= 0 && index < slides.length) navigate(index);
    });
    gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-step]").forEach(button =>
      button.addEventListener("click", () => navigate(selected + Number(button.dataset.galleryStep))));
    gallery.addEventListener("keydown", event => {
      const target = event.target as HTMLElement;
      if (target !== track && !target.closest("[data-gallery-index]")) return;
      const key = event.key;
      if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(key)) return;
      event.preventDefault();
      const current = target === track ? selected : Number(target.closest<HTMLElement>("[data-gallery-index]")!.dataset.galleryIndex);
      navigate(key === "Home" ? 0 : key === "End" ? slides.length - 1 : current + (key === "ArrowRight" ? 1 : -1), target !== track);
    });
    // 伺服器端已依網址預選的變體標好第幾張；從這張接手並捲到位
    if (initialIndex > 0 && initialIndex < slides.length) navigate(initialIndex);
    let frame = 0;
    let measuredWidth = track.clientWidth;
    let restoreAfterLayout = false;
    const restorePosition = () => {
      const width = track.clientWidth;
      if (width <= 0 || !restoreAfterLayout) return;
      restoreAfterLayout = false;
      measuredWidth = width;
      track.scrollTo({ left: selected * width, behavior: "instant" });
    };
    new ResizeObserver(() => {
      const width = track.clientWidth;
      if (width !== measuredWidth) restoreAfterLayout = true;
      restorePosition();
    }).observe(track);
    track.addEventListener("scroll", () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        // Layout measurement or a temporarily hidden gallery can have zero width.
        const width = track.clientWidth;
        if (width <= 0) {
          restoreAfterLayout = true;
          // A temporary measurement can restore its width before ResizeObserver runs.
          requestAnimationFrame(restorePosition);
        } else if (restoreAfterLayout || width !== measuredWidth) {
          restoreAfterLayout = true;
          restorePosition();
        } else {
          select(Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / width))));
        }
      });
    }, { passive: true });
  }
</script>

<style>
  .gallery { min-width: 0; }
  .gallery-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; border-radius: var(--radius-lg); background: var(--color-panel); }
  .gallery-slide[data-initial] { scroll-initial-target: nearest; }
  .gallery-slide { flex: 0 0 100%; min-width: 0; scroll-snap-align: start; scroll-snap-stop: always; }
  .gallery-slide img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
  .gallery-controls { display: flex; justify-content: center; align-items: center; gap: var(--space-4); margin-block: var(--space-3); }
  .gallery-controls button { width: var(--control-height); }
  .gallery-thumbnails { display: flex; flex-wrap: wrap; gap: var(--space-2); padding: var(--space-1); }
  .gallery-thumbnails button { width: var(--product-thumb-size); height: var(--product-thumb-size); padding: 3px; background: var(--color-panel); border: 2px solid var(--color-control-border); }
  .gallery-thumbnails button[aria-current="true"] { border-color: var(--color-text); box-shadow: 0 0 0 1px var(--color-text); }
  .gallery-thumbnails img { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
