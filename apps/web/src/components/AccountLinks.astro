---
import { LOGIN_PATH, loginUrl } from "../auth/customer";

// 桌機 header 與手機抽屜共用的帳號區：已登入顯示我的訂單、顧客名與登出，未登入顯示登入連結
interface Props {
  customer: { name: string } | null | undefined;
  url: URL;
}
const { customer, url } = Astro.props;
---

{
  customer ? (
    <>
      <a href="/orders">我的訂單</a>
      <span class="customer-name">{customer.name}</span>
      <button type="button" data-sign-out>登出</button>
    </>
  ) : url.pathname === LOGIN_PATH ? null : (
    <a href={loginUrl(url)}>登入</a>
  )
}
