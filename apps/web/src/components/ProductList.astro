---
import type { ProductSummary } from "@storefront/app/catalog-types";
import { cardPrice } from "../catalog/listing-price";
import CartToast from "./CartToast.astro";

interface Props {
  products: ProductSummary[];
  /** 商品名稱的標題層級：預設 h2；放在已有 h2 區塊標題底下的頁面傳 3。 */
  headingLevel?: 2 | 3;
  /** 第一張封面是否立即載入；列表首屏可以，頁面中段的區塊（例如首頁精選）不該搶頻寬。 */
  eagerFirst?: boolean;
}
const { products, headingLevel = 2, eagerFirst = true } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<ul class="product-list">
  {products.map((p, index) => {
    const { text: priceText, sale, hasSaleOption } = cardPrice(p);
    return (
    <li class:list={["product-card", { "is-sold-out": !p.purchasable, "on-sale": sale || hasSaleOption }]}>
      <a class="product-link" href={`/products/${p.id}`}>
        <span class="cover-frame">
          {/* 同一個連結的標題已提供商品名稱，封面不再重複朗讀。 */}
          {p.cover
            ? <img
                src={`/images/${p.cover.variants[0]!.key}`}
                srcset={p.cover.variants.map(v => `/images/${v.key} ${v.width}w`).join(", ")}
                sizes="(min-width: 56.25rem) 18rem, 50vw"
                width={p.cover.variants.at(-1)!.width}
                height={p.cover.variants.at(-1)!.height}
                alt={p.name}
                aria-hidden="true"
                loading={eagerFirst && index === 0 ? "eager" : "lazy"}
              />
            : <span class="cover-placeholder">暫無商品圖片</span>}
          {!p.purchasable && <span class="sold-out">{priceText === null ? "已停賣" : "已售完"}</span>}
          {sale?.badge && <span class="sale-tag"><span aria-hidden="true">{sale.badge}</span><span class="visually-hidden">省 {sale.percent}%</span></span>}
        </span>
        <Heading>{p.name}</Heading>
      </a>
      <p class="price">
        {priceText === null
          ? <span class="price-now unavailable">目前無法購買</span>
          : <span class="price-now">{priceText}</span>}
        {sale && <s class="price-was"><span class="visually-hidden">原價 </span>NT$ {new Intl.NumberFormat("zh-TW").format(sale.compareAtTwd)}</s>}
        {hasSaleOption && <span class="sale-option">有特價選項</span>}
        {p.hasOptions && p.purchasable && <span class="choose-options">選擇規格</span>}
      </p>
      {p.purchasable && !p.hasOptions && p.priceTwd !== null && (
        <form class="add-to-cart" data-product-id={p.id} data-variant-id={p.defaultVariantId} data-name={p.name} data-price={p.priceTwd} data-cover={JSON.stringify(p.cover)}>
          <input type="hidden" name="quantity" value="1" />
          <button type="submit" class="add-button" aria-label={`加入購物車：${p.name}`}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M3 4h2l2.4 11h11.2L21 7H7" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="9" cy="19" r="1.5" fill="currentColor" /><circle cx="17" cy="19" r="1.5" fill="currentColor" /></svg>
          </button>
          <CartToast />
        </form>
      )}
    </li>
    );
  })}
</ul>

<script>
  import { parseCartCover } from "../cart/cover";
  import { clearCartToast, showCartToast } from "../cart/toast";
  import { addAvailableItem } from "../cart/purchase";

  // 商品資料來自頁面上的 data 屬性（伺服器端渲染時放入），加入當下的單價就是顧客看到的單價
  for (const form of document.querySelectorAll<HTMLFormElement>("form.add-to-cart")) {
    let pending = false;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (pending) return;
      pending = true;
      const button = form.querySelector<HTMLButtonElement>("button")!;
      button.setAttribute("aria-disabled", "true");
      clearCartToast(form.querySelector<HTMLElement>(".cart-status")!);
      const item = {
        variantId: Number(form.dataset.variantId),
        productId: Number(form.dataset.productId),
        name: form.dataset.name ?? "",
        unitPriceTwd: Number(form.dataset.price),
        cover: parseCartCover(JSON.parse(form.dataset.cover ?? "null")),
      };
      const quantity = Number(new FormData(form).get("quantity"));
      const result = await addAvailableItem(item, quantity);
      showCartToast(form.querySelector<HTMLElement>(".cart-status")!, result.message);
      pending = false;
      button.setAttribute("aria-disabled", "false");
    });
  }
</script>

<style>
  /* 質感商品卡網格：清晰層次與間距 */
  .product-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  @media (min-width: 56.25rem) {
    .product-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  .product-card {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    transition: transform var(--duration-normal) var(--ease-spring), box-shadow var(--duration-normal) var(--ease-smooth), border-color var(--duration-fast);
  }
  .product-card:hover {
    z-index: 2;
    border-color: var(--color-control-border);
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }
  .product-card:focus-within { z-index: 2; }
  .product-link { color: var(--color-text); text-decoration: none; display: flex; flex-direction: column; flex: 1 0 auto; }
  .product-link:hover :is(h2, h3) { color: var(--color-primary); }
  .cover-frame {
    position: relative;
    display: block;
    aspect-ratio: 1;
    background: var(--color-panel);
    overflow: hidden;
  }
  .cover-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-normal) var(--ease-smooth);
  }
  .product-card:hover .cover-frame img {
    transform: scale(1.03);
  }
  .cover-placeholder { display: grid; place-items: center; width: 100%; height: 100%; font-size: var(--text-sm); color: var(--color-muted); }
  .is-sold-out img { opacity: 0.5; filter: grayscale(40%); }
  .sold-out {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-on-inverse);
    background: rgba(28, 27, 26, 0.85);
    backdrop-filter: blur(4px);
    border-radius: var(--radius-xs);
  }
  .sale-tag {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-on-inverse);
    background: var(--color-primary);
    border-radius: var(--radius-xs);
    box-shadow: 0 2px 6px rgba(158, 61, 44, 0.25);
  }
  .product-card :is(h2, h3) {
    margin: var(--space-3) var(--space-3) 0;
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.4;
    transition: color var(--duration-fast);
  }
  .price {
    margin: var(--space-2) var(--space-3) var(--space-4);
    padding-right: calc(44px + var(--space-3));
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .price .price-now {
    font-size: var(--text-base);
    font-weight: 700;
  }
  .price .unavailable { color: var(--color-muted); }
  .sale-option, .choose-options { display: block; font-size: var(--text-sm); font-weight: 500; }
  .sale-option { color: var(--color-primary); }
  .choose-options { color: var(--color-muted); }
  .add-to-cart { margin: 0; }
  .add-button {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    min-height: 38px;
    padding: 0;
    color: var(--color-text);
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    box-shadow: 0 1px 3px rgba(28, 27, 26, 0.05);
    transition: all var(--duration-fast) var(--ease-spring);
  }
  .add-button:hover {
    color: var(--color-on-inverse);
    background: var(--color-primary);
    border-color: var(--color-primary);
    box-shadow: 0 4px 10px rgba(158, 61, 44, 0.3);
    transform: scale(1.06);
  }
  .add-button:active {
    transform: scale(0.96);
  }
</style>
