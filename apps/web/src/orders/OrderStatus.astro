---
import { customerOrderStatusLabel, orderStatusLabel } from "./labels";
interface Props { status: string; customer?: boolean }
const { status, customer = false } = Astro.props;
---
<strong class:list={["order-status", status, customer && "customer"]}>{customer ? customerOrderStatusLabel(status) : orderStatusLabel(status)}</strong>
<style>
  .order-status {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    line-height: 1.3;
  }
  .pending_payment { color: #854d0e; background: #fef9c3; border: 1px solid #fde047; }
  .paid { color: #166534; background: #dcfce7; border: 1px solid #bbf7d0; }
  .partially_shipped { color: #1e40af; background: #eff6ff; border: 1px solid #bfdbfe; }
  .shipped { color: #1e40af; background: #dbeafe; border: 1px solid #bfdbfe; }
  .expired { color: #991b1b; background: #fee2e2; border: 1px solid #fecaca; }
  .cancelled { color: #52525b; background: #f4f4f5; border: 1px solid #e4e4e7; }
  :global(body.storefront-shell) .order-status.customer {
    color: var(--color-text);
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    font-weight: 500;
  }
</style>
