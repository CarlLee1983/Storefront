---
import type { ProductImage } from "@storefront/app/product-images";
import OrderCover from "./OrderCover.astro";
interface Props { lines: Array<{ productName: string; variantLabel: string; quantity: number; unitPriceTwd: number; cover: ProductImage | null }> }
const { lines } = Astro.props;
const priceFormat = new Intl.NumberFormat("zh-TW");
---
<ul class="order-lines" aria-label="訂單明細">
  {lines.map(line => <li>
    <OrderCover cover={line.cover} name={line.productName} customer />
    <div class="description"><strong>{line.productName}</strong>{line.variantLabel && <p class="variant-label">規格：{line.variantLabel}</p>}<p>單價（下單當時）：NT$ {priceFormat.format(line.unitPriceTwd)}<br />數量：{line.quantity}</p></div>
    <p class="subtotal">小計：<strong>NT$ {priceFormat.format(line.unitPriceTwd * line.quantity)}</strong></p>
  </li>)}
</ul>
<style>
  .order-lines { list-style: none; padding: 0; margin-block: var(--space-4); }
  li { display: flex; flex-wrap: wrap; gap: var(--space-3); padding-block: var(--space-4); border-bottom: 1px solid var(--color-border); align-items: center; }
  .description { flex: 1; min-width: 8rem; }
  p { margin: var(--space-1) 0; }
  .description p { color: var(--color-muted); font-size: var(--text-sm); }
  .subtotal { flex-basis: 100%; text-align: right; }
  @media(min-width: 40rem) { .subtotal { flex-basis: auto; margin-left: auto; } }
</style>
